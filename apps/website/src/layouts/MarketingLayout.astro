---
import ThemeProvider from '@astrojs/starlight/components/ThemeProvider.astro';
import '../styles/global.css';
import { siteUrl } from '../lib/site-urls';
const {
  title = 'Nepali Toolkit',
  description = 'TypeScript utilities for building applications for Nepal.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = siteUrl(Astro.url.pathname, Astro.site!, base);
const image = siteUrl('social/switchboard.png', Astro.site!, base);
const schema = {
  '@context': 'https://schema.org', '@type': 'SoftwareSourceCode', name: 'Nepali Toolkit',
  description, url: canonical, codeRepository: 'https://github.com/kbohara315/nepali-toolkit',
  programmingLanguage: 'TypeScript',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/plain" title="AI documentation index" href={siteUrl('llms.txt', Astro.site!, base)} />
    <link rel="alternate" type="text/plain" title="Full AI documentation" href={siteUrl('llms-full.txt', Astro.site!, base)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Local conventions. One toolkit. Nepali Toolkit domain switchboard." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <ThemeProvider />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
  </body>
</html>
