---
/**
 * Playground — runs the real `nepali-toolkit` workspace package in the browser.
 *
 * Two rules shape this component:
 *
 * 1. Progressive enhancement. The sample input, its real result, and a complete
 *    importable snippet are rendered here at build time from the same package
 *    this page depends on (`nepali-toolkit: workspace:*`). A visitor without
 *    JavaScript therefore still sees a true result, not a placeholder. The
 *    browser-enhanced workbench then runs the selected task on page load.
 *
 * 2. Explicit lazy loading. Every domain is a separate dynamic `import()` keyed
 *    by the `entrypoint` string in the table below, so the bundler emits one
 *    chunk per subpath. Nothing is requested until a mode needs it, which keeps
 *    the `admin` dataset off the initial landing payload.
 *
 * The mode table is the single source of truth: the options, the format
 * guidance, the build-time sample, and the config handed to the client are all
 * derived from it, so a mode's copy cannot drift from its behaviour.
 */
import { formatNumber } from 'nepali-toolkit/number';
import { highlightCode } from '../lib/highlight-code';
import HairlineFigure from './HairlineFigure.astro';

type ModeId =
  | 'number'
  | 'digits'
  | 'date-bs-to-ad'
  | 'date-ad-to-bs'
  | 'currency'
  | 'land'
  | 'words'
  | 'phone'
  | 'collation'
  | 'admin';

type Mode = {
  id: ModeId;
  label: string;
  /** Package subpath the browser imports on demand. */
  entrypoint: string;
  /**
   * Exports of that subpath this mode draws on, in source order. Used to build
   * the build-time sample's import line; each generated snippet then imports
   * only the names its own body calls, so nothing unused is shown.
   */
  exports: readonly string[];
  /** Deterministic sample. Never derived from the current date. */
  sample: string;
  /** Accepted input shape, announced through `aria-describedby`. */
  hint: string;
  placeholder: string;
  inputMode: 'text' | 'numeric' | 'decimal';
  /** An empty value is a legitimate query rather than a missing value. */
  optional?: boolean;
  /** Base-aware docs path for this mode, e.g. `/docs/reference/number/`. */
  docs: string;
  /**
   * Reference-page name used in link copy. Kept separate from `label` because
   * a mode label names the operation ("ASCII ↔ Devanagari digits") while this
   * names the page that documents it ("number").
   */
  reference: string;
  /** Clickable example values: valid cases plus one invalid/edge case. */
  examples: string[];
};

const modes: readonly Mode[] = [
  {
    id: 'number',
    label: 'Number grouping',
    entrypoint: 'nepali-toolkit/number',
    exports: ['formatNumber'],
    sample: '12345678',
    hint: 'Decimal text, sent as a string so large values and decimals are never rounded by a float.',
    placeholder: '12345678',
    inputMode: 'decimal',
    docs: '/docs/reference/number/',
    reference: 'number',
    examples: ['12345678', '123456.789', 'abc'],
  },
  {
    id: 'digits',
    label: 'ASCII ↔ Devanagari digits',
    entrypoint: 'nepali-toolkit/number/digits',
    exports: ['toDevanagari', 'toAscii'],
    sample: '२०८२',
    hint: 'Any text. Both directions run, so you can check a round trip.',
    placeholder: '२०८२',
    inputMode: 'text',
    docs: '/docs/reference/number/',
    reference: 'number',
    examples: ['२०८२', '2082', 'Test 123'],
  },
  {
    id: 'date-bs-to-ad',
    label: 'BS → AD date',
    entrypoint: 'nepali-toolkit/date',
    exports: ['bs', 'toAD'],
    sample: '2082-04-07',
    hint: 'Bikram Sambat date as YYYY-MM-DD, for example 2082-04-07.',
    placeholder: '2082-04-07',
    inputMode: 'numeric',
    docs: '/docs/reference/date/',
    reference: 'date',
    examples: ['2082-04-07', '2082-01-01', '2082-13-99'],
  },
  {
    id: 'date-ad-to-bs',
    label: 'AD → BS date',
    entrypoint: 'nepali-toolkit/date',
    exports: ['ad', 'toBS'],
    sample: '2025-07-23',
    hint: 'Gregorian date as YYYY-MM-DD, for example 2025-07-23.',
    placeholder: '2025-07-23',
    inputMode: 'numeric',
    docs: '/docs/reference/date/',
    reference: 'date',
    examples: ['2025-07-23', '2025-01-01', '2025-13-99'],
  },
  {
    id: 'currency',
    label: 'NPR currency',
    entrypoint: 'nepali-toolkit/currency',
    exports: ['formatNPR'],
    sample: '123456.50',
    hint: 'Decimal text in rupees. Defaults to a leading रु, Nepali grouping, and Devanagari digits.',
    placeholder: '123456.50',
    inputMode: 'decimal',
    docs: '/docs/reference/currency/',
    reference: 'currency',
    examples: ['123456.50', '1000', 'abc'],
  },
  {
    id: 'land',
    label: 'Hill land area',
    entrypoint: 'nepali-toolkit/land',
    exports: ['hillArea', 'formatHillArea'],
    sample: '2',
    hint: 'Whole ropani. Fractional and negative values are rejected; aana, paisa, and daam cover finer units.',
    placeholder: '2',
    inputMode: 'numeric',
    docs: '/docs/reference/land/',
    reference: 'land',
    examples: ['2', '10', '-2'],
  },
  {
    id: 'words',
    label: 'Nepali words',
    entrypoint: 'nepali-toolkit/words',
    exports: ['numberToNepaliWords'],
    sample: '2082',
    hint: 'A number in decimal text, without digit grouping or an exponent.',
    placeholder: '2082',
    inputMode: 'decimal',
    docs: '/docs/reference/words/',
    reference: 'words',
    examples: ['2082', '100', 'abc'],
  },
  {
    id: 'phone',
    label: 'Nepal phone number',
    entrypoint: 'nepali-toolkit/phone',
    exports: ['parseNepalPhone', 'isValidNepalPhone'],
    sample: '9841234567',
    hint: 'National, international, or prefixed text. Spaces, dashes, and brackets are tolerated.',
    placeholder: '9841234567',
    inputMode: 'text',
    docs: '/docs/reference/phone/',
    reference: 'phone',
    examples: ['9841234567', '+977-1-4441234', '123'],
  },
  {
    id: 'collation',
    label: 'Nepali text inspection',
    entrypoint: 'nepali-toolkit/collation',
    exports: ['getNepaliTextStats'],
    sample: 'नेपाल सरकार। ठीक छ।',
    hint: 'Nepali or mixed text. Counts follow word-counter semantics, with sentences split on । ॥ ? and !.',
    placeholder: 'नेपाल सरकार। ठीक छ।',
    inputMode: 'text',
    docs: '/docs/reference/collation/',
    reference: 'collation',
    examples: ['नेपाल सरकार। ठीक छ।', 'hello world', '!'],
  },
  {
    id: 'admin',
    label: 'Province lookup',
    entrypoint: 'nepali-toolkit/admin',
    exports: ['getProvinces', 'getDistricts', 'getPalikas', 'getPalikaWards'],
    sample: 'koshi',
    hint: 'Optional. Empty lists every province; otherwise search Nepali or English name text.',
    placeholder: 'koshi',
    inputMode: 'text',
    optional: true,
    docs: '/docs/reference/admin/',
    reference: 'admin',
    examples: ['koshi', 'बागमती', 'xyz'],
  },
];
const navGroups: readonly { group: string; ids: readonly ModeId[] }[] = [
  { group: 'Numbers & currency', ids: ['number', 'digits', 'currency', 'words'] },
  { group: 'Dates', ids: ['date-bs-to-ad', 'date-ad-to-bs'] },
  { group: 'Land & text', ids: ['land', 'collation', 'phone', 'admin'] },
];
const taskDescriptions: Record<ModeId, string> = {
  number: 'Format grouped decimals or parse them back into exact decimal text.',
  digits: 'Convert ASCII and Devanagari digits while preserving the surrounding text.',
  'date-bs-to-ad': 'Convert Bikram Sambat dates and explore calendar operations.',
  'date-ad-to-bs': 'Convert Gregorian dates and explore calendar operations.',
  currency: 'Format an exact rupee amount with the currency style you choose.',
  land: 'Enter Hill or Terai units and compare equivalent area measurements.',
  words: 'Render number text in Nepali, English, or NPR amount wording.',
  phone: 'Parse a Nepal number and inspect its structure and validation status.',
  collation: 'Count, sort, or search Nepali and mixed-script text.',
  admin: 'Browse Nepal’s province, district, palika, and ward hierarchy.',
};

/**
 * The build-time sample shown to everyone, including visitors without
 * JavaScript. Derived from the first mode in the table and formatted exactly
 * like the client-generated snippets, so switching modes and back produces
 * identical code and the served markup cannot drift from live behaviour.
 */
const sampleMode = modes[0];
const sampleValue = formatNumber(sampleMode.sample);
const sampleSnippet = [
  `import { ${sampleMode.exports.join(', ')} } from '${sampleMode.entrypoint}';`,
  '',
  `const grouped = ${sampleMode.exports[0]}(${JSON.stringify(sampleMode.sample)});`,
  `// → ${JSON.stringify(sampleValue)}`,
].join('\n');

/** Handed to the client script; trimmed to the fields it actually reads. */
const clientConfig = {
  base: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`,
  modes: modes.map(({ id, label, entrypoint, docs, reference, examples, sample, hint, placeholder, inputMode, optional }) => ({
    id,
    label,
    description: taskDescriptions[id],
    entrypoint,
    docs,
    reference,
    examples,
    sample,
    hint,
    placeholder,
    inputMode,
    optional: optional === true,
  })),
};

/** Base-aware hrefs rendered server-side so the default mode works with JS off. */
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const sampleDocsHref = `${base}${sampleMode.docs.slice(1)}`;
const installHref = `${base}docs/getting-started/`;

/** `<` is escaped so a future label can never close the JSON script element. */
const configJson = JSON.stringify(clientConfig).replace(/</g, '\\u003c');
---

<script is:inline>
  // Marks scripting as available so the no-JS guidance can be removed before it
  // paints, while staying in the served HTML for everyone else.
  document.documentElement.classList.add('has-js');
</script>

<section
  class="demo-section site-shell"
  id="try-it"
  aria-label="Utility playground"
  data-playground
  data-state="ready"
>
  <div class="demo-grid">
    <aside class="demo-controls playground-sidebar" aria-label="Utility navigation" data-utility-sidebar>
      <label for="playground-search">Find a utility</label>
      <input id="playground-search" type="search" placeholder="Search utilities…" autocomplete="off" aria-controls="playground-utilities" disabled />
      <nav id="playground-utilities" aria-label="Utilities" class="playground-nav">
        {navGroups.map(({ group, ids }) => (
          <section class="playground-nav-group" aria-label={group}>
            <span class="eyebrow">{group}</span>
            {modes.filter(({ id }) => ids.includes(id)).map((mode) => (
              <button type="button" class="playground-nav-item" data-tool={mode.id} aria-current={mode.id === sampleMode.id ? 'true' : undefined} disabled>{mode.label}</button>
            ))}
          </section>
        ))}
      </nav>
      <label class="playground-select-label" for="playground-mode" aria-hidden="true">Choose a task</label>
      <select id="playground-mode" name="domain" aria-label="Choose utility" aria-hidden="true" tabindex="-1" disabled>
        <optgroup label="Numbers & currency">
        {modes.filter(({ id }) => ['number', 'digits', 'currency', 'words'].includes(id)).map((mode) => (
          <option value={mode.id}>{mode.label}</option>
        ))}
        </optgroup>
        <optgroup label="Dates">
        {modes.filter(({ id }) => id.startsWith('date-')).map((mode) => (
          <option value={mode.id}>{mode.label}</option>
        ))}
        </optgroup>
        <optgroup label="Land & text">
        {modes.filter(({ id }) => ['land', 'collation', 'phone', 'admin'].includes(id)).map((mode) => (
          <option value={mode.id}>{mode.label}</option>
        ))}
        </optgroup>
      </select>
    </aside>

    <section class="playground-workspace" id="playground-workspace" aria-label="Selected utility workspace" data-playground-workspace>
      <header class="playground-task-heading">
        <h2 id="playground-task-title">{sampleMode.label}</h2>
        <p id="playground-task-description">{taskDescriptions[sampleMode.id]}</p>
      </header>

      <section class="playground-task-form" aria-label="Task input">
        <div id="playground-options" class="playground-options"></div>

        <label for="playground-input" id="playground-input-label">Input</label>
        <input
          id="playground-input"
          name="input"
          type="text"
          value={sampleMode.sample}
          placeholder={sampleMode.placeholder}
          inputmode={sampleMode.inputMode}
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          disabled
          aria-invalid="false"
          aria-describedby="playground-hint playground-status"
        />

        <p class="playground-hint" id="playground-hint">{sampleMode.hint}</p>
        <div class="playground-examples" id="playground-examples" role="group" aria-label="Example values"></div>
        <p class="playground-note" id="playground-note" hidden></p>
        <p class="playground-status" id="playground-status" role="status">
          Sample result. Edit the input to run the function.
        </p>

        <button class="playground-text-button" id="playground-reset" type="button" disabled>
          Reset to sample
        </button>
      </section>

      <section class="demo-output" aria-label="Result and code">
        <span class="eyebrow">Result</span>

        <div class="playground-result" id="playground-result">
          <output class="playground-value" id="playground-value" for="playground-input">{sampleValue}</output>
          <ul class="playground-list" id="playground-list" hidden></ul>
          <pre class="playground-json" id="playground-json" hidden></pre>
          <HairlineFigure
            name="grouping-tray"
            title="Number grouping tray"
            description="Example: 12345678 → 1,23,45,678. Move over a group to lift its counters."
            referenceHref="docs/reference/number/"
            referenceLabel="Number reference"
            dataHairlineFor="number"
            initiallyHidden={false}
          />
          <HairlineFigure
            name="printing-press"
            title="Nepali words printing press"
            description="The press advances as the pointer moves. The result above shows the Nepali words."
            referenceHref="docs/reference/words/"
            referenceLabel="Words reference"
            dataHairlineFor="words"
            initiallyHidden={true}
          />
        </div>

        <div class="playground-view-toggle" id="playground-view-toggle" hidden role="group" aria-label="Result view">
          <button type="button" data-result-view="preview" aria-pressed="true">Preview</button>
          <button type="button" data-result-view="json" aria-pressed="false">JSON</button>
        </div>

        <div class="playground-actions">
          <button class="button secondary" id="playground-copy-result" type="button" disabled>
            Copy result
          </button>
          <button class="playground-text-button" id="playground-copy-json" type="button" hidden>Copy JSON</button>
          <button class="playground-text-button" id="playground-copy-snippet" type="button" disabled>
            Copy snippet
          </button>
        </div>

        <div class="playground-snippet">
          <span class="eyebrow">Snippet</span>
          <div class="playground-code">
            <pre><code id="playground-snippet" set:html={highlightCode(sampleSnippet)}></code></pre>
            <div class="playground-code-meta">
              <p class="playground-entrypoint">
                Entry point <code id="playground-entrypoint">{sampleMode.entrypoint}</code>
              </p>
              <p class="playground-docs">
                <a id="playground-docs-link" href={sampleDocsHref}>Read the {sampleMode.reference} reference →</a>
                <a href={installHref}>Install →</a>
              </p>
            </div>
          </div>
        </div>
      </section>
    </section>
  </div>

  <details class="playground-provenance">
    <summary>Where do these results come from?</summary>
    <p>
      Every value comes from <code>nepali-toolkit</code> 0.1.0, published on npm
      and included in this static site build. Utilities run in your browser from
      the package code bundled with this page; requests are not sent to a remote
      compute server, and user input is passed to library functions (never evaluated as code).
    </p>
  </details>

  <p class="playground-nojs">
    JavaScript is off, so the utility controls are inert. The result and snippet
    above are the real build-time output of <code>nepali-toolkit</code> 0.1.0,
    published on npm and bundled into this static site. Enable JavaScript to
    switch utilities, edit options, and run inputs in your browser.
  </p>
</section>

<!-- `is:inline` keeps the JSON payload in place instead of being hoisted. -->
<script
  is:inline
  type="application/json"
  id="playground-config"
  set:html={configJson}
></script>

<style>
  /* --------------------------------------------------------------------
   * The `.demo-*` layout, borders, and the large display type on
   * `.demo-output output` come from the shared landing stylesheet. The
   * rules below cover only what this component adds.
   * -------------------------------------------------------------------- */

  :global(.demo-section .demo-grid) {
    grid-template-columns: minmax(225px, 0.72fr) minmax(0, 1.8fr);
    align-items: stretch;
  }
  .playground-sidebar {
    min-width: 0;
  }
  .playground-workspace {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .playground-task-heading {
    padding: 26px 30px 18px;
    border-bottom: 1px solid var(--line);
  }
  .playground-task-heading h2 {
    margin: 0;
    color: var(--ink);
    font: 600 clamp(1.2rem, 2vw, 1.55rem)/1.25 var(--sans);
    letter-spacing: -0.035em;
  }
  .playground-task-heading p {
    max-width: 54ch;
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.65;
  }
  .playground-task-form {
    min-width: 0;
    padding: 22px 30px 26px;
    border-bottom: 1px solid var(--line);
  }
  .playground-task-form > label,
  .playground-options label {
    display: block;
    margin: 0 0 8px;
    color: var(--ink);
    font: 0.65rem var(--mono);
  }
  .playground-task-form > input,
  .playground-options input,
  .playground-options select,
  .playground-options textarea {
    width: 100%;
    min-height: 42px;
    margin: 0 0 14px;
    padding: 9px 11px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--canvas);
    color: var(--ink);
    font: 0.8rem/1.5 var(--sans);
  }
  .playground-task-form > input[hidden] {
    display: none;
  }
  .playground-options textarea {
    min-height: 100px;
    font-family: var(--mono);
  }
  .playground-options [hidden] {
    display: none !important;
  }
  .playground-options .land-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .playground-options .land-fields label {
    min-width: 0;
  }
  .playground-options .land-fields input {
    margin-top: 7px;
  }
  .playground-options fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 12px;
    padding: 10px;
    border: 1px solid var(--line);
  }
  .playground-options fieldset legend {
    padding: 0 5px;
    color: var(--muted);
    font: 0.62rem var(--mono);
  }
  .playground-options fieldset label {
    flex: 1 1 72px;
  }
  .playground-options fieldset input {
    margin-top: 6px;
  }
  .playground-options > p {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  /* Devanagari is a first-class output here, so it gets a real fallback
     face instead of inheriting a Latin-only sans or mono stack. */
  .playground-value,
  .playground-list,
  .playground-json {
    font-family: 'Noto Sans Devanagari', 'Nirmala UI', 'Mangal', var(--sans);
  }
  .playground-value {
    line-height: 1.35;
  }
  /* Devanagari shows up inside snippet string literals, so the mono stack needs
     a real Devanagari fallback. Declared once here and used by every `<code>`
     below, so no rule has to out-specify another to win. */
  .playground-snippet {
    --pg-mono: 'SFMono-Regular', Consolas, 'Liberation Mono', 'Noto Sans Devanagari',
      'Nirmala UI', 'Mangal', monospace;
  }

  .playground-hint,
  .playground-note,
  .playground-status,
  .playground-entrypoint {
    margin: 0;
    font: 0.65rem/1.7 var(--mono);
  }
  .playground-hint {
    /* Pulls the hint up against the field's own bottom margin. */
    margin-top: -10px;
    margin-bottom: 14px;
    color: var(--muted);
  }
  .playground-note {
    margin-bottom: 12px;
    padding: 8px 10px;
    border-left: 2px solid var(--strong-line);
    background: var(--canvas);
    color: var(--muted);
  }
  .playground-status {
    color: var(--muted);
  }
  /* Failure is signalled by weight and a border, never by colour alone. */
  [data-state='error'] .playground-status {
    color: var(--ink);
    font-weight: 600;
  }
  [data-state='error'] .playground-note {
    border-left-color: var(--ink);
  }

  .playground-text-button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: 0.65rem var(--mono);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .playground-text-button:hover:not(:disabled) {
    color: var(--ink);
  }
  .playground-text-button:disabled,
  .button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .button:disabled:hover {
    transform: none;
    border-color: var(--line);
  }

  /* Reserved height keeps loading, empty, error, and result states from
     shifting the snippet below them. */
  .playground-result {
    width: 100%;
    min-height: 150px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  /* `hidden` has to outrank the shared `.demo-output output` display rule. */
  .playground-value[hidden],
  .playground-list[hidden],
  .playground-json[hidden],
  .playground-view-toggle[hidden] {
    display: none;
  }
  .playground-list {
    width: 100%;
    margin: 22px 0;
    padding: 0;
    list-style: none;
  }
  .playground-list li {
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .playground-list li:last-child {
    border-bottom: 0;
  }
  .playground-json { white-space: pre-wrap; overflow-wrap: anywhere; font: 0.75rem/1.7 var(--mono); }
  .playground-options { display: grid; gap: 10px; margin-bottom: 12px; }
  .playground-options:empty { display: none; }
  .playground-options label { margin: 0; }
  .playground-options select, .playground-options input { width: 100%; }
  .playground-view-toggle { display: flex; gap: 4px; margin: 0 0 12px; }
  .playground-view-toggle button { border: 1px solid var(--line); padding: 6px 10px; background: var(--surface); color: var(--muted); font: 0.65rem var(--mono); cursor: pointer; }
  .playground-view-toggle button[aria-pressed='true'] { border-color: var(--strong-line); color: var(--ink); }
  #playground-search { margin-bottom: 12px; }
  .playground-nav { display: grid; gap: 16px; margin: 4px 0 16px; }
  .playground-nav-group { display: grid; gap: 5px; }
  .playground-nav-group > .eyebrow { color: var(--muted); margin-bottom: 2px; }
  .playground-nav-item { width: 100%; text-align: left; padding: 8px 10px; border: 1px solid transparent; border-radius: 4px; background: transparent; color: var(--muted); font: 0.75rem/1.4 var(--sans); cursor: pointer; }
  .playground-nav-item:hover, .playground-nav-item[aria-current='true'] { border-color: var(--line); background: var(--surface); color: var(--ink); }
  .playground-nav-item:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .playground-select-label, #playground-mode { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .playground-options textarea { width: 100%; min-height: 100px; padding: 10px; border: 1px solid var(--line); background: var(--canvas); color: var(--ink); font: 0.8rem/1.6 var(--mono); }
  .playground-task-form .playground-options label { margin-bottom: 8px; }
  .playground-workspace > .demo-output { border-top: 0; }
  .playground-options select,
  .playground-options input,
  .playground-task-form > input {
    min-height: 42px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--canvas);
    color: var(--ink);
    font: 0.8rem/1.5 var(--sans);
  }
  .playground-task-form > input { margin-bottom: 14px; }
  .playground-task-form > input[aria-invalid='true'] { border: 2px solid var(--ink); }

  .playground-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
  }
  .playground-actions .playground-text-button {
    margin-top: 25px;
  }

  .playground-snippet {
    width: 100%;
    margin-top: 30px;
  }
  .playground-snippet > .eyebrow {
    color: var(--muted);
  }
  /* One code card: the `<pre>` is the only box, and the metadata sits in a
     caption bar under it. Same surface tokens as the landing code window
     (`.board-code`), so both read as the same component family. */
  .playground-code {
    margin-top: 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--code-bg);
    overflow: hidden;
    box-shadow: inset 0 1px 2px #0000000b;
  }
  .playground-code pre {
    margin: 0;
    padding: 16px 18px;
    background: none;
    /* Long lines scroll inside the card instead of widening the page. */
    overflow-x: auto;
  }
  .playground-code code {
    /* `width: max-content` keeps long lines from adding a phantom scrollbar. */
    display: block;
    width: max-content;
    min-width: 100%;
    font: 0.75rem/1.8 var(--pg-mono);
    color: var(--code-fg);
  }
  .playground-code-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 18px;
    padding: 10px 18px;
    border-top: 1px solid var(--line);
    background: var(--surface);
  }
  .playground-code-meta p {
    margin: 0;
  }
  .playground-code-meta code {
    /* The entry point is an inline value inside the caption, not a block. */
    display: inline;
    width: auto;
    font-family: var(--pg-mono);
    font-size: 0.65rem;
    color: var(--ink);
  }
  /* Same token palette as the landing code window; scoped here so the
     highlighted snippet keeps its colours wherever this component is used. */
  .playground-snippet .code-keyword { color: var(--code-keyword); }
  .playground-snippet .code-function { color: var(--code-function); }
  .playground-snippet .code-string { color: var(--code-string); }
  .playground-snippet .code-comment { color: var(--muted); }
  .playground-entrypoint {
    color: var(--muted);
  }
  .playground-examples {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  /* Spacing lives here (not on the chips) so the row breathes, but only
     when the client has populated it — the server renders the container
     empty for no-JS honesty, and it must collapse to zero height. */
  .playground-examples:not(:empty) {
    margin: -6px 0 14px;
  }
  .playground-chip {
    min-height: 32px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--canvas);
    color: var(--muted);
    font: 0.65rem var(--mono);
    cursor: pointer;
  }
  .playground-chip:hover {
    border-color: var(--strong-line);
    color: var(--ink);
  }
  .playground-docs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font: 0.65rem/1.7 var(--mono);
  }
  .playground-docs a {
    color: var(--muted);
    text-underline-offset: 3px;
  }
  .playground-docs a:hover {
    color: var(--ink);
  }
  .playground-provenance {
    margin: 18px 0 0;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.8;
  }
  .playground-provenance summary {
    cursor: pointer;
    font: 0.65rem var(--mono);
  }
  .playground-provenance p {
    margin: 10px 0 0;
  }

  .playground-nojs {
    margin: 18px 0 0;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.8;
  }
  :global(html.has-js) .playground-nojs {
    display: none;
  }

  @media (max-width: 760px) {
    :global(.demo-section .demo-grid) { grid-template-columns: minmax(0, 1fr); }
    .playground-sidebar {
      min-width: 0;
      padding: 16px 18px 12px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .playground-sidebar > label[for='playground-search'] { margin-bottom: 7px; }
    #playground-search { margin-bottom: 8px; }
    .playground-nav {
      display: flex;
      min-width: 0;
      max-width: 100%;
      gap: 12px;
      margin: 2px 0 0;
      padding: 4px 1px 8px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: thin;
    }
    .playground-nav-group {
      display: flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 4px;
    }
    .playground-nav-group > .eyebrow {
      max-width: 70px;
      margin: 0;
      white-space: normal;
      font-size: 0.53rem;
      line-height: 1.25;
    }
    .playground-nav-item {
      width: max-content;
      min-height: 36px;
      flex: 0 0 auto;
      padding: 7px 9px;
      white-space: nowrap;
      font-size: 0.68rem;
    }
    .playground-task-heading { padding: 20px 18px 14px; }
    .playground-task-form { padding: 18px; }
    .playground-workspace > .demo-output { padding: 18px; }
    .playground-task-form .land-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script>
  type ModeId =
    | 'number'
    | 'digits'
    | 'date-bs-to-ad'
    | 'date-ad-to-bs'
    | 'currency'
    | 'land'
    | 'words'
    | 'phone'
    | 'collation'
    | 'admin';

  type ClientMode = {
    id: ModeId;
    label: string;
    description: string;
    entrypoint: string;
    docs: string;
    reference: string;
    examples: string[];
    sample: string;
    hint: string;
    placeholder: string;
    inputMode: 'text' | 'numeric' | 'decimal';
    optional: boolean;
  };

  /**
   * A finished run. `empty` is a neutral prompt rather than a failure, and only
   * a real rejection becomes an `error`. `snippet` is absent whenever there is
   * no honest, complete example to offer, so a placeholder can never be
   * mistaken for a copyable snippet.
   */
  type Outcome =
    | { kind: 'value'; text: string; snippet: string; json?: unknown }
    | { kind: 'list'; items: string[]; snippet: string; json?: unknown }
    | { kind: 'empty'; text: string; guidance: string; snippet?: string }
    | { kind: 'error'; message: string; snippet?: undefined };

  /** A dynamically imported subpath, narrowed per mode at the call site. */
  type ToolkitModule = Record<string, unknown>;

  type Fields = { year: number; month: number; day: number };
  type Province = { code: string; nameEn: string; nameNe: string };
  type ParsedPhone = { kind: string; e164: string; operator?: string };

  const config = JSON.parse(
    document.querySelector('#playground-config')?.textContent ?? '{}',
  ) as { base: string; modes: ClientMode[] };
  const siteBase = config.base.endsWith('/') ? config.base : `${config.base}/`;

  const root = document.querySelector<HTMLElement>('[data-playground]')!;
  const modeField = document.querySelector<HTMLSelectElement>('#playground-mode')!;
  const navItems = Array.from(document.querySelectorAll<HTMLButtonElement>('.playground-nav-item'));
  const inputField = document.querySelector<HTMLInputElement>('#playground-input')!;
  const searchField = document.querySelector<HTMLInputElement>('#playground-search')!;
  const optionFields = document.querySelector<HTMLElement>('#playground-options')!;
  const inputLabel = document.querySelector<HTMLElement>('#playground-input-label')!;
  const taskTitle = document.querySelector<HTMLElement>('#playground-task-title')!;
  const taskDescription = document.querySelector<HTMLElement>('#playground-task-description')!;
  const hint = document.querySelector<HTMLElement>('#playground-hint')!;
  const note = document.querySelector<HTMLElement>('#playground-note')!;
  const status = document.querySelector<HTMLElement>('#playground-status')!;
  const resultRegion = document.querySelector<HTMLElement>('#playground-result')!;
  const hairlineFigures = Array.from(resultRegion.querySelectorAll<HTMLElement>('[data-hairline-for]'));
  const valueSlot = document.querySelector<HTMLOutputElement>('#playground-value')!;
  const listSlot = document.querySelector<HTMLUListElement>('#playground-list')!;
  const jsonSlot = document.querySelector<HTMLElement>('#playground-json')!;
  const viewToggle = document.querySelector<HTMLElement>('#playground-view-toggle')!;
  const copyJson = document.querySelector<HTMLButtonElement>('#playground-copy-json')!;
  const snippet = document.querySelector<HTMLElement>('#playground-snippet')!;
  const entrypointLabel = document.querySelector<HTMLElement>('#playground-entrypoint')!;
  const docsLink = document.querySelector<HTMLAnchorElement>('#playground-docs-link')!;
  const examplesWrap = document.querySelector<HTMLElement>('#playground-examples')!;
  const reset = document.querySelector<HTMLButtonElement>('#playground-reset')!;
  const copyResult = document.querySelector<HTMLButtonElement>('#playground-copy-result')!;
  const copySnippet = document.querySelector<HTMLButtonElement>('#playground-copy-snippet')!;

  for (const control of root.querySelectorAll<HTMLButtonElement | HTMLInputElement | HTMLSelectElement>(':disabled')) control.disabled = false;

  type ModeState = { input: string; controls: Record<string, string> };
  const modeStates = new Map<ModeId, ModeState>();
  let activeModeId = modeField.value as ModeId;

  function activeInput(mode: ClientMode): string {
    if (mode.id === 'collation') {
      return document.querySelector<HTMLTextAreaElement>('#playground-collation-text')?.value ?? inputField.value;
    }
    return inputField.value;
  }

  function controlKey(control: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement): string | undefined {
    if (control.id) return control.id;
    const landUnit = control.dataset.landUnit;
    return landUnit ? `land:${landUnit}` : undefined;
  }

  function rememberModeState(mode: ClientMode): void {
    const hierarchyNotMounted = mode.id === 'admin' && !optionFields.querySelector('#playground-province');
    const controls: Record<string, string> = hierarchyNotMounted
      ? { ...(modeStates.get(mode.id)?.controls ?? {}) }
      : {};
    for (const control of optionFields.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')) {
      const key = controlKey(control);
      if (key) controls[key] = control.value;
    }
    if (mode.id === 'collation') {
      const searchQuery = inputField.dataset.searchQuery;
      if (searchQuery !== undefined) controls['playground-collation-query'] = searchQuery;
    }
    modeStates.set(mode.id, { input: activeInput(mode), controls });
  }

  function savedControl(mode: ClientMode, key: string, fallback: string): string {
    return modeStates.get(mode.id)?.controls[key] ?? fallback;
  }

  // --- Lazy domain loading ------------------------------------------------
  // One dynamic import per subpath: the bundler keeps these in separate
  // chunks, and none is requested until its mode is used. Each value is typed
  // as `Promise<unknown>` so the namespace object needs no cast here; the
  // narrowing to the functions a mode actually uses happens in its handler.
  const loaders: Record<string, () => Promise<unknown>> = {
    'nepali-toolkit/number': () => import('nepali-toolkit/number'),
    'nepali-toolkit/number/digits': () => import('nepali-toolkit/number/digits'),
    'nepali-toolkit/date': () => import('nepali-toolkit/date'),
    'nepali-toolkit/currency': () => import('nepali-toolkit/currency'),
    'nepali-toolkit/land': () => import('nepali-toolkit/land'),
    'nepali-toolkit/words': () => import('nepali-toolkit/words'),
    'nepali-toolkit/phone': () => import('nepali-toolkit/phone'),
    'nepali-toolkit/collation': () => import('nepali-toolkit/collation'),
    'nepali-toolkit/admin/provinces': () => import('nepali-toolkit/admin/provinces'),
    'nepali-toolkit/admin': () => import('nepali-toolkit/admin'),
  };

  const load = async (entrypoint: string): Promise<ToolkitModule> => {
    const loader = loaders[entrypoint];
    if (!loader) throw new Error(`Unknown entry point ${entrypoint}`);
    return (await loader()) as ToolkitModule;
  };

  // --- Small helpers ------------------------------------------------------

  /** A quoted JavaScript string literal, safe to paste into a snippet. */
  const literal = (value: string): string => JSON.stringify(value);

  const importLine = (mode: ClientMode, names: readonly string[]): string =>
    `import { ${names.join(', ')} } from '${mode.entrypoint}';`;

  const selectedValue = (id: string, fallback: string): string =>
    document.querySelector<HTMLSelectElement>(`#${id}`)?.value ?? fallback;

  function selectedTaskTitle(mode: ClientMode): string {
    const operationControl: Partial<Record<ModeId, string>> = {
      number: '#playground-number-operation',
      'date-bs-to-ad': '#playground-date-task',
      'date-ad-to-bs': '#playground-date-task',
      words: '#playground-words-task',
      collation: '#playground-collation-task',
    };
    const operationId = operationControl[mode.id];
    if (operationId) {
      const selected = document.querySelector<HTMLSelectElement>(operationId)?.selectedOptions[0]?.textContent;
      if (selected) return selected;
    }

    const fixedTitles: Partial<Record<ModeId, string>> = {
      currency: 'Format NPR currency',
      land: 'Convert land area',
      phone: 'Inspect phone number',
      admin: 'Browse administrative data',
    };
    return fixedTitles[mode.id] ?? mode.label;
  }

  const isoDate = (fields: Fields): string =>
    `${fields.year}-${String(fields.month).padStart(2, '0')}-${String(fields.day).padStart(2, '0')}`;

  function secondaryDateFields(): Fields {
    const values = Array.from(
      document.querySelectorAll<HTMLInputElement>('[data-date-secondary]'),
      (field) => Number(field.value),
    );
    return { year: values[0], month: values[1], day: values[2] };
  }

  function dateOperationOutcome(
    mode: ClientMode,
    result: unknown,
    imports: readonly string[],
    call: string,
  ): Outcome {
    const hasDateFields = typeof result === 'object' && result !== null && 'year' in result;
    const text = hasDateFields ? isoDate(result as Fields) : String(result);
    const json = typeof result === 'object' && result !== null ? result : undefined;
    return {
      kind: 'value',
      text,
      json,
      snippet: [importLine(mode, imports), '', `${call}; // → ${literal(text)}`].join('\n'),
    };
  }

  const plural = (count: number, noun: string): string => (count === 1 ? noun : `${noun}s`);

  const CIVIL_DATE = /^(\d{4})-(\d{1,2})-(\d{1,2})$/;

  /**
   * Splits a civil date into numeric fields so the snippet shows the same
   * normalized numbers the function received. Month lengths are deliberately
   * left to the library, which is the authority on what a valid BS date is.
   */
  function civilFields(raw: string, calendar: string, example: string): [number, number, number] {
    const match = CIVIL_DATE.exec(raw);
    if (!match) {
      throw new Error(`Enter a ${calendar} date as YYYY-MM-DD, for example ${example}.`);
    }
    return [Number(match[1]), Number(match[2]), Number(match[3])];
  }

  const describeError = (error: unknown): string =>
    error instanceof Error && error.message ? error.message : 'The library rejected this value.';

  /**
   * Supported-range guidance read from the library rather than restated here,
   * so it cannot fall behind the generated data.
   */
  async function rangeNote(calendar: 'bs' | 'ad'): Promise<string> {
    const { range } = (await load('nepali-toolkit/date')) as {
      range: { bsStart: Fields; bsEnd: Fields; adStart: Fields; adEnd: Fields };
    };
    const span = `Supported range: BS ${isoDate(range.bsStart)} to ${isoDate(range.bsEnd)} (AD ${isoDate(range.adStart)} to ${isoDate(range.adEnd)}).`;
    return calendar === 'bs'
      ? `${span} BS month lengths vary, so not every month has 30 or 31 days.`
      : `${span} Gregorian leap years apply to the input.`;
  }

  // --- Per-mode behaviour -------------------------------------------------
  // Each handler receives the same normalized input the field holds, calls the
  // real function, and returns both the display value and a snippet built from
  // the values that were actually passed in.

  const handlers: Record<ModeId, (mode: ClientMode, raw: string) => Promise<Outcome>> = {
    async number(mode, raw) {
      const { formatNumber, parseNumber } = (await load(mode.entrypoint)) as {
        formatNumber: (value: string, options?: Record<string, unknown>) => string;
        parseNumber: (value: string) => string;
      };
      const value = raw.trim();
      const grouping = selectedValue('playground-number-grouping', 'nepali');
      const numerals = selectedValue('playground-number-numerals', 'ascii');
      const operation = selectedValue('playground-number-operation', 'format');
      const text = operation === 'parse' ? parseNumber(value) : formatNumber(value, { grouping, numerals });
      const imports = operation === 'parse' ? ['parseNumber'] : ['formatNumber'];
      const call = operation === 'parse'
        ? `const parsed = parseNumber(${literal(value)});`
        : `const grouped = formatNumber(${literal(value)}, ${JSON.stringify({ grouping, numerals })});`;
      return {
        kind: 'value',
        text,
        snippet: [
          importLine(mode, imports),
          '',
          call,
          `// → ${literal(text)}`,
        ].join('\n'),
      };
    },

    async digits(mode, raw) {
      const { toAscii, toDevanagari } = (await load(mode.entrypoint)) as {
        toAscii: (value: string) => string;
        toDevanagari: (value: string) => string;
      };
      if (raw.trim() === '') {
        return {
          kind: 'empty',
          text: '—',
          guidance: 'Type some text to convert its digits in both directions.',
        };
      }
      const devanagari = toDevanagari(raw);
      const ascii = toAscii(raw);
      return {
        kind: 'value',
        text: `${devanagari}  ←  ${ascii}`,
        snippet: [
          importLine(mode, ['toDevanagari', 'toAscii']),
          '',
          `const text = ${literal(raw)};`,
          `toDevanagari(text); // → ${literal(devanagari)}`,
          `toAscii(text);    // → ${literal(ascii)}`,
        ].join('\n'),
      };
    },

    async 'date-bs-to-ad'(mode, raw) {
      const { bs, toAD } = (await load(mode.entrypoint)) as {
        bs: (year: number, month: number, day: number) => unknown;
        toAD: (value: unknown) => Fields;
      };
      const [year, month, day] = civilFields(raw.trim(), 'Bikram Sambat', mode.sample);
      const dateText = isoDate({ year, month, day });
      const operation = (document.querySelector('#playground-date-task') as HTMLSelectElement | null)?.value ?? 'convert';
      if (operation !== 'convert') {
        const dateApi = await load('nepali-toolkit/date') as {
          addDaysBS: (date: object, days: number) => unknown;
          differenceInDaysBS: (left: object, right: object) => number;
          formatBS: (date: object, format: string) => string;
          getFiscalYear: (date: object) => number;
          parseBS: (date: string) => object;
          bs: (year: number, month: number, day: number) => object;
        };
        const date = bs(year, month, day) as object;

        if (operation === 'add') {
          const days = Number((document.querySelector('#playground-date-days') as HTMLInputElement).value);
          return dateOperationOutcome(
            mode,
            dateApi.addDaysBS(date, days),
            ['bs', 'addDaysBS'],
            `addDaysBS(bs(${year}, ${month}, ${day}), ${days})`,
          );
        }
        if (operation === 'difference') {
          const other = secondaryDateFields();
          return dateOperationOutcome(
            mode,
            dateApi.differenceInDaysBS(date, dateApi.bs(other.year, other.month, other.day)),
            ['bs', 'differenceInDaysBS'],
            `differenceInDaysBS(bs(${year}, ${month}, ${day}), bs(${other.year}, ${other.month}, ${other.day}))`,
          );
        }
        if (operation === 'fiscal') {
          return dateOperationOutcome(
            mode,
            dateApi.getFiscalYear(date),
            ['bs', 'getFiscalYear'],
            `getFiscalYear(bs(${year}, ${month}, ${day}))`,
          );
        }

        const parsed = dateApi.parseBS(dateText);
        return dateOperationOutcome(
          mode,
          dateApi.formatBS(parsed, 'YYYY-MM-DD'),
          ['parseBS', 'formatBS'],
          `formatBS(parseBS(${literal(dateText)}), 'YYYY-MM-DD')`,
        );
      }
      const converted = toAD(bs(year, month, day));
      return {
        kind: 'value',
        text: isoDate(converted),
        json: converted,
        snippet: [
          importLine(mode, ['bs', 'toAD']),
          '',
          `const adDate = toAD(bs(${year}, ${month}, ${day}));`,
          `// → { year: ${converted.year}, month: ${converted.month}, day: ${converted.day} }`,
        ].join('\n'),
      };
    },

    async 'date-ad-to-bs'(mode, raw) {
      const { ad, toBS } = (await load(mode.entrypoint)) as {
        ad: (year: number, month: number, day: number) => unknown;
        toBS: (value: unknown) => Fields;
      };
      const [year, month, day] = civilFields(raw.trim(), 'Gregorian', mode.sample);
      const dateText = isoDate({ year, month, day });
      const operation = (document.querySelector('#playground-date-task') as HTMLSelectElement | null)?.value ?? 'convert';
      if (operation !== 'convert') {
        const dateApi = await load('nepali-toolkit/date') as {
          addDaysAD: (date: object, days: number) => unknown;
          differenceInDaysAD: (left: object, right: object) => number;
          formatAD: (date: object, format: string) => string;
          parseAD: (date: string) => object;
          ad: (year: number, month: number, day: number) => object;
        };
        const date = ad(year, month, day) as object;

        if (operation === 'add') {
          const days = Number((document.querySelector('#playground-date-days') as HTMLInputElement).value);
          return dateOperationOutcome(
            mode,
            dateApi.addDaysAD(date, days),
            ['ad', 'addDaysAD'],
            `addDaysAD(ad(${year}, ${month}, ${day}), ${days})`,
          );
        }
        if (operation === 'difference') {
          const other = secondaryDateFields();
          return dateOperationOutcome(
            mode,
            dateApi.differenceInDaysAD(date, dateApi.ad(other.year, other.month, other.day)),
            ['ad', 'differenceInDaysAD'],
            `differenceInDaysAD(ad(${year}, ${month}, ${day}), ad(${other.year}, ${other.month}, ${other.day}))`,
          );
        }

        const parsed = dateApi.parseAD(dateText);
        return dateOperationOutcome(
          mode,
          dateApi.formatAD(parsed, 'YYYY-MM-DD'),
          ['parseAD', 'formatAD'],
          `formatAD(parseAD(${literal(dateText)}), 'YYYY-MM-DD')`,
        );
      }
      const converted = toBS(ad(year, month, day));
      return {
        kind: 'value',
        text: isoDate(converted),
        json: converted,
        snippet: [
          importLine(mode, ['ad', 'toBS']),
          '',
          `const bsDate = toBS(ad(${year}, ${month}, ${day}));`,
          `// → { year: ${converted.year}, month: ${converted.month}, day: ${converted.day} }`,
        ].join('\n'),
      };
    },

    async currency(mode, raw) {
      const { formatNPR } = (await load(mode.entrypoint)) as {
        formatNPR: (value: string, options?: Record<string, unknown>) => string;
      };
      const value = raw.trim();
      const placement = selectedValue('playground-currency-placement', 'before');
      const numerals = selectedValue('playground-currency-digits', 'devanagari');
      const symbol = selectedValue('playground-currency-symbol', 'रु');
      const options = { placement, numerals, symbol };
      const text = formatNPR(value, options);
      return {
        kind: 'value',
        text,
        snippet: [
          importLine(mode, ['formatNPR']),
          '',
          `const amount = formatNPR(${literal(value)}, ${JSON.stringify(options)});`,
          `// → ${literal(text)}`,
        ].join('\n'),
      };
    },

    async land(mode, raw) {
      const { hillArea, teraiArea, formatHillArea, formatTeraiArea, toSquareMetres, toSquareFeet } = (await load(mode.entrypoint)) as {
        hillArea: (fields: Record<string, number>) => { um2: bigint };
        teraiArea: (fields: Record<string, number>) => { um2: bigint };
        formatHillArea: (area: unknown) => string;
        formatTeraiArea: (area: unknown) => string;
        toSquareMetres: (area: { um2: bigint }) => string;
        toSquareFeet: (area: { um2: bigint }) => string;
      };
      const system = selectedValue('playground-land-system', 'hill');
      const units = system === 'hill' ? ['ropani', 'aana', 'paisa', 'daam'] : ['bigha', 'kattha', 'dhur'];
      const fields = Object.fromEntries(units.map(name => {
        const field = document.querySelector<HTMLInputElement>(`[data-land-unit="${name}"]`);
        const value = field?.value || (name === units[0] ? raw.trim() : '0');
        if (!/^\d+$/.test(value)) throw new Error(`${name} must be a non-negative whole number.`);
        return [name, Number(value)];
      }));
      const area = system === 'hill' ? hillArea(fields) : teraiArea(fields);
      const native = system === 'hill' ? formatHillArea(area) : formatTeraiArea(area);
      const squareMetres = toSquareMetres(area);
      const squareFeet = toSquareFeet(area);
      const text = `${native}\n${squareMetres} m²\n${squareFeet} ft²`;
      const areaFunction = system === 'hill' ? 'hillArea' : 'teraiArea';
      const formatFunction = system === 'hill' ? 'formatHillArea' : 'formatTeraiArea';
      const importedFunctions = [areaFunction, formatFunction, 'toSquareMetres', 'toSquareFeet'];
      const inputJson = JSON.stringify(fields);
      return {
        kind: 'value',
        text,
        json: { system, input: fields, native, squareMetres, squareFeet, squareMicrometres: area.um2.toString() },
        snippet: [
          importLine(mode, importedFunctions),
          '',
          `const area = ${areaFunction}(${inputJson});`,
          `${formatFunction}(area); // → ${literal(native)}`,
          `toSquareMetres(area); // → ${literal(squareMetres)}`,
          `toSquareFeet(area); // → ${literal(squareFeet)}`,
        ].join('\n'),
      };
    },

    async words(mode, raw) {
      const { numberToNepaliWords, numberToEnglishWords, amountToNepaliWordsNPR } = (await load(mode.entrypoint)) as {
        numberToNepaliWords: (value: string) => string;
        numberToEnglishWords: (value: string) => string;
        amountToNepaliWordsNPR: (value: string) => string;
      };
      const value = raw.trim();
      const operation = selectedValue('playground-words-task', 'nepali');
      let functionName: string;
      let text: string;
      if (operation === 'english') {
        functionName = 'numberToEnglishWords';
        text = numberToEnglishWords(value);
      } else if (operation === 'npr') {
        functionName = 'amountToNepaliWordsNPR';
        text = amountToNepaliWordsNPR(value);
      } else {
        functionName = 'numberToNepaliWords';
        text = numberToNepaliWords(value);
      }
      return {
        kind: 'value',
        text,
        snippet: [
          importLine(mode, [functionName]),
          '',
          `const words = ${functionName}(${literal(value)});`,
          `// → ${literal(text)}`,
        ].join('\n'),
      };
    },

    async phone(mode, raw) {
      const {
        parseNepalPhone,
        isValidNepalPhone,
        isPossibleNepalPhone,
        isAllocatedNepalPhone,
        getNepalPhoneType,
      } = (await load(mode.entrypoint)) as {
        parseNepalPhone: (value: string) => ParsedPhone;
        isValidNepalPhone: (value: ParsedPhone) => boolean;
        isPossibleNepalPhone: (value: string) => boolean;
        isAllocatedNepalPhone: (value: ParsedPhone) => boolean;
        getNepalPhoneType: (value: ParsedPhone) => string;
      };
      const value = raw.trim();
      // An unrecognised shape throws InvalidPhoneError, which surfaces as
      // inline feedback with the library's own wording.
      const possible = isPossibleNepalPhone(value);
      const phone = parseNepalPhone(value);
      const valid = isValidNepalPhone(phone);
      const allocated = isAllocatedNepalPhone(phone);
      const type = getNepalPhoneType(phone);
      const details = { ...phone, type, possible, valid, allocated };
      const lines = [
        importLine(mode, [
          'parseNepalPhone',
          'isPossibleNepalPhone',
          'isValidNepalPhone',
          'isAllocatedNepalPhone',
          'getNepalPhoneType',
        ]),
        '',
        `const phone = parseNepalPhone(${literal(value)});`,
        `isPossibleNepalPhone(${literal(value)}); // → ${possible}`,
        `isValidNepalPhone(phone); // → ${valid}`,
        `isAllocatedNepalPhone(phone); // → ${allocated}`,
        `getNepalPhoneType(phone); // → ${literal(type)}`,
      ];
      if (phone.operator !== undefined) {
        lines.push(`phone.operator;             // → ${literal(phone.operator)}`);
      }
      return {
        kind: 'value',
        text: [
          phone.e164,
          type,
          `possible ${possible}`,
          `valid ${valid}`,
          `allocated ${allocated}`,
          phone.operator,
        ].filter(Boolean).join(' · '),
        json: details,
        snippet: lines.join('\n'),
      };
    },

    async collation(mode, raw) {
      const {
        getNepaliTextStats,
        createNepaliCollator,
        nepaliIncludes,
      } = (await load(mode.entrypoint)) as {
        getNepaliTextStats: (value: string) => {
          words: number;
          characters: number;
          sentences: number;
          paragraphs: number;
        };
        createNepaliCollator: () => { sort(values: readonly string[]): string[] };
        nepaliIncludes: (value: string, query: string) => boolean;
      };
      const task = selectedValue('playground-collation-task', 'stats');
      if (task === 'sort') {
        const values = raw.split(/\r?\n/).map(line => line.trim()).filter(Boolean);
        const sorted = createNepaliCollator().sort(values);
        return {
          kind: 'value',
          text: sorted.join('\n'),
          json: sorted,
          snippet: [
            importLine(mode, ['createNepaliCollator']),
            '',
            `const values = ${JSON.stringify(values)};`,
            'const sorted = createNepaliCollator().sort(values);',
            `// → ${JSON.stringify(sorted)}`,
          ].join('\n'),
        };
      }
      if (task === 'search') {
        const query = inputField.dataset.searchQuery ?? '';
        const matches = nepaliIncludes(raw, query);
        return {
          kind: 'value',
          text: String(matches),
          snippet: [
            importLine(mode, ['nepaliIncludes']),
            '',
            `nepaliIncludes(${literal(raw)}, ${literal(query)}); // → ${matches}`,
          ].join('\n'),
        };
      }
      const stats = getNepaliTextStats(raw);
      if (stats.words === 0) {
        return {
          kind: 'empty',
          text: '0 words',
          guidance: 'Type some Nepali or mixed text to count words, sentences, and paragraphs.',
        };
      }
      return {
        kind: 'value',
        text: [
          `${stats.words} ${plural(stats.words, 'word')}`,
          `${stats.sentences} ${plural(stats.sentences, 'sentence')}`,
          `${stats.characters} ${plural(stats.characters, 'character')}`,
        ].join(' · '),
        json: stats,
        snippet: [
          importLine(mode, ['getNepaliTextStats']),
          '',
          `const stats = getNepaliTextStats(${literal(raw)});`,
          `// → ${JSON.stringify(stats)}`,
        ].join('\n'),
      };
    },

    async admin(mode, raw) {
      const {
        getProvinces,
        getProvince,
        findProvincesByName,
        getDistrict,
        getDistricts,
        getPalika,
        getPalikas,
        getPalikaWards,
        getPostalCode,
        getWardPostalCode,
      } = (await load(mode.entrypoint)) as {
        getProvinces: () => readonly Province[];
        getProvince: (code: string) => Province | undefined;
        findProvincesByName: (query: string) => readonly Province[];
        getDistrict: (code: string) => { code: string; nameEn: string; nameNe: string } | undefined;
        getDistricts: (province?: string) => readonly { code: string; nameEn: string; nameNe: string }[];
        getPalika: (code: string) => { code: string; nameEn: string; nameNe: string; wards: number } | undefined;
        getPalikas: (district?: string) => readonly { code: string; nameEn: string; nameNe: string; wards: number }[];
        getPalikaWards: (code: string) => readonly number[];
        getPostalCode: (code: string) => string | undefined;
        getWardPostalCode: (code: string, ward: number) => string | undefined;
      };
      const describe = (province: Province) =>
        `${province.nameNe} · ${province.nameEn} · code ${province.code}`;

      // An empty query is a valid request for the whole list, so this mode
      // keeps a real snippet even in its empty state.
      const selected = (id: string) => (document.querySelector(`#${id}`) as HTMLSelectElement | null)?.value ?? '';
      const provinceCode = selected('playground-province');
      const districtCode = selected('playground-district');
      const palikaCode = selected('playground-palika');
      const ward = Number(selected('playground-ward')) || 0;
      const query = raw.trim();
      if (provinceCode) {
        const province = getProvince(provinceCode);
        const district = districtCode ? getDistrict(districtCode) : undefined;
        const palika = palikaCode ? getPalika(palikaCode) : undefined;
        const districts = getDistricts(provinceCode);
        const palikas = districtCode ? getPalikas(districtCode) : [];
        const wards = palikaCode ? getPalikaWards(palikaCode) : [];
        const postalCode = palikaCode
          ? ward ? getWardPostalCode(palikaCode, ward) : getPostalCode(palikaCode)
          : undefined;
        const json = {
          province,
          districts,
          district,
          palikas,
          palika,
          wards,
          ward: ward || undefined,
          postalScheme: 'GPO-derived palika/ward code; not legacy post-office postal codes',
          postalCode,
        };
        const imports = [
          'getProvince',
          'getDistricts',
          ...(districtCode ? ['getDistrict', 'getPalikas'] : []),
          ...(palikaCode ? ['getPalika', 'getPalikaWards', ...(ward ? ['getWardPostalCode'] : ['getPostalCode'])] : []),
        ];
        const lines = [
          importLine(mode, imports),
          '',
          `const provinceCode = ${literal(provinceCode)};`,
          'const province = getProvince(provinceCode);',
          'const districts = getDistricts(provinceCode);',
        ];
        if (districtCode) {
          lines.push(
            `const districtCode = ${literal(districtCode)};`,
            'const district = getDistrict(districtCode);',
            'const palikas = getPalikas(districtCode);',
          );
        }
        if (palikaCode) {
          lines.push(
            `const palikaCode = ${literal(palikaCode)};`,
            'const palika = getPalika(palikaCode);',
            'const wards = getPalikaWards(palikaCode);',
          );
          if (ward) lines.push(`const wardNo = ${ward};`, 'const postalCode = getWardPostalCode(palikaCode, wardNo);');
          else lines.push('const postalCode = getPostalCode(palikaCode);');
        }
        return {
          kind: 'value',
          text: [
            province?.nameEn,
            district?.nameEn,
            palika?.nameEn,
            ward ? `Ward ${ward}` : '',
            postalCode ? `GPO code ${postalCode}` : '',
          ].filter(Boolean).join(' · '),
          json,
          snippet: lines.join('\n'),
        };
      }
      if (query === '') {
        const provinces = getProvinces();
        return {
          kind: 'list',
          items: provinces.map(describe),
          json: provinces,
          snippet: [
            importLine(mode, ['getProvinces']),
            '',
            'const provinces = getProvinces();',
            `// → ${provinces.length} provinces`,
          ].join('\n'),
        };
      }

      const matches = findProvincesByName(query);
      if (matches.length === 0) {
        return {
          kind: 'empty',
          text: `No province matches “${query}”.`,
          guidance: 'Search covers Nepali and English name text. Try koshi, lumbini, or बागमती.',
          snippet: [
            importLine(mode, ['getProvinces', 'findProvincesByName']),
            '',
            `findProvincesByName(${literal(query)});`,
            '// → []',
          ].join('\n'),
        };
      }
      return {
        kind: 'list',
        items: matches.map(describe),
        snippet: [
          importLine(mode, ['getProvinces', 'findProvincesByName']),
          '',
          `findProvincesByName(${literal(query)});`,
          `// → ${matches.length} of 7 provinces`,
        ].join('\n'),
      };
    },
  };

  // --- Rendering ----------------------------------------------------------

  /**
   * Client copy of `highlightCode` (`src/lib/highlight-code.ts`). Kept inline
   * because this script is not bundled and cannot import the shared module.
   * Always render snippets through this — never assign raw snippet text to
   * `innerHTML`, or user input inside the snippet becomes an XSS vector.
   * Copy still reads the raw source (`painted.snippet`), never this HTML.
   */
  const snippetTokenPattern =
    /(\/\/[^\n]*|'(?:\\.|[^'\\])*'|"(?:\\.|[^"\\])*"|\b(?:import|from|const|let|return|new|true|false)\b|\b[A-Za-z_$][\w$]*(?=\s*\())/g;

  function escapeSnippetHtml(value: string): string {
    return value.replace(/[&<>"']/g, (character) => {
      switch (character) {
        case '&':
          return '&amp;';
        case '<':
          return '&lt;';
        case '>':
          return '&gt;';
        case '"':
          return '&quot;';
        default:
          return '&#39;';
      }
    });
  }

  function highlightSnippet(source: string): string {
    let cursor = 0;
    let html = '';
    snippetTokenPattern.lastIndex = 0;
    for (const match of source.matchAll(snippetTokenPattern)) {
      const token = match[0];
      const index = match.index ?? cursor;
      html += escapeSnippetHtml(source.slice(cursor, index));
      const kind = token.startsWith('//')
        ? 'code-comment'
        : token.startsWith("'") || token.startsWith('"')
          ? 'code-string'
          : /^(import|from|const|let|return|new|true|false)$/.test(token)
            ? 'code-keyword'
            : 'code-function';
      html += `<span class="${kind}">${escapeSnippetHtml(token)}</span>`;
      cursor = index + token.length;
    }
    return html + escapeSnippetHtml(source.slice(cursor));
  }

  type Painted = { result: string; snippet: string; json: string };

  // Seeded from the served markup, which already holds a real build-time result.
  let painted: Painted = {
    result: valueSlot.textContent ?? '',
    snippet: snippet.textContent ?? '', json: '',
  };
  let currentIsList = false;
  let resultView: 'preview' | 'json' = 'preview';

  function showHairline(mode: ClientMode, outcome?: Outcome): void {
    const valid = resultView === 'preview' && (outcome === undefined || (outcome.kind !== 'error' && outcome.kind !== 'empty'));
    const showNumber = valid && mode.id === 'number'
      && selectedValue('playground-number-operation', 'format') === 'format'
      && selectedValue('playground-number-grouping', 'nepali') === 'nepali';
    const wordsTask = selectedValue('playground-words-task', 'nepali');
    const showWords = valid && mode.id === 'words' && wordsTask !== 'english';
    hairlineFigures.forEach((figure) => {
      figure.hidden = figure.dataset.hairlineFor === 'number' ? !showNumber : !showWords;
    });
  }

  function setState(state: 'ready' | 'loading' | 'error' | 'empty', message: string): void {
    root.dataset.state = state;
    status.textContent = message;
    resultRegion.setAttribute('aria-busy', String(state === 'loading'));
    if (state === 'error') inputField.setAttribute('aria-invalid', 'true');
    else inputField.removeAttribute('aria-invalid');
  }

  function scalarOf(outcome: Outcome): string {
    if (outcome.kind === 'list') return outcome.items.join('\n');
    if (outcome.kind === 'error') return outcome.message;
    return outcome.text;
  }

  /** JSON view is portable: exact bigint values are represented as decimal strings. */
  function serializeResult(value: unknown): string {
    return JSON.stringify(value, (_key, item) => typeof item === 'bigint' ? item.toString() : item, 2);
  }

  function paint(outcome: Outcome): void {
    const isError = outcome.kind === 'error';
    showHairline(modeById(modeField.value), outcome);
    // Raw source stays in `painted` so Copy copies clean code, not HTML.
    // The visible `<code>` gets the highlighted form of the same source.
    const nextSnippet = isError ? '' : (outcome.snippet ?? '');

    snippet.innerHTML = nextSnippet === '' ? '' : highlightSnippet(nextSnippet);
    const json = !isError && (outcome.kind === 'value' || outcome.kind === 'list') && outcome.json !== undefined
      ? serializeResult(outcome.json) : '';
    currentIsList = outcome.kind === 'list';
    painted = { result: isError ? '' : scalarOf(outcome), snippet: nextSnippet, json };
    viewToggle.hidden = json === '';
    copyJson.hidden = json === '';
    jsonSlot.hidden = json === '' || resultView !== 'json';
    valueSlot.hidden = outcome.kind === 'list' || (json !== '' && resultView === 'json');
    jsonSlot.textContent = json;

    if (outcome.kind === 'list') {
      valueSlot.hidden = true;
      listSlot.hidden = resultView === 'json';
      // Values come from the packaged dataset, but textContent is used so no
      // path can ever interpret a value as markup.
      listSlot.replaceChildren(
        ...outcome.items.map((item) => {
          const li = document.createElement('li');
          li.textContent = item;
          return li;
        }),
      );
    } else {
      listSlot.hidden = true;
      listSlot.replaceChildren();
      valueSlot.hidden = json !== '' && resultView === 'json';
      valueSlot.textContent = isError ? '—' : outcome.text;
    }

    // A list has no single scalar to copy and an empty state has no result
    // worth copying, but an empty state may still have a complete snippet.
    copyResult.disabled = outcome.kind === 'list' || outcome.kind === 'empty';
    copyResult.textContent = json !== '' && resultView === 'json' ? 'Copy value' : 'Copy result';
    copySnippet.disabled = outcome.snippet === undefined;

    const message =
      outcome.kind === 'error'
        ? outcome.message
        : outcome.kind === 'empty'
          ? outcome.guidance
          : 'Updated from nepali-toolkit.';
    setState(
      outcome.kind === 'error' ? 'error' : outcome.kind === 'empty' ? 'empty' : 'ready',
      message,
    );
  }

  // --- Run loop -----------------------------------------------------------

  const modeById = (id: string): ClientMode =>
    config.modes.find((mode) => mode.id === id) ?? config.modes[0];

  /**
   * Renders the current mode's example chips as real buttons. textContent is
   * used throughout so an example value can never become markup.
   */
  function renderExamples(mode: ClientMode): void {
    examplesWrap.replaceChildren(
      ...mode.examples.map((example) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'playground-chip';
        chip.textContent = example;
        chip.setAttribute('aria-label', `Try example ${example}`);
        chip.addEventListener('click', () => {
          inputField.value = example;
          if (mode.id.startsWith('date-')) {
            const fields = example.split('-');
            ['year', 'month', 'day'].forEach((name, index) => {
              const target = document.querySelector<HTMLInputElement>(`#playground-${name}`);
              if (target) target.value = fields[index] ?? '';
            });
          } else if (mode.id === 'land') {
            const system = selectedValue('playground-land-system', 'hill');
            const firstUnit = system === 'hill' ? 'ropani' : 'bigha';
            const target = document.querySelector<HTMLInputElement>(`[data-land-unit="${firstUnit}"]`);
            if (target) target.value = example;
          } else if (mode.id === 'collation') {
            const text = document.querySelector<HTMLTextAreaElement>('#playground-collation-text');
            if (text) text.value = example;
          }
          void run();
          inputField.focus();
        });
        return chip;
      }),
    );
  }

  function renderOptions(mode: ClientMode): void {
    optionFields.replaceChildren();
    inputLabel.textContent = mode.id.startsWith('date-')
      ? 'Date (year-month-day)'
      : mode.id === 'land' ? 'Land area' : 'Input';
    const addSelect = (
      label: string,
      id: string,
      options: Array<[string, string]>,
      value: string,
    ): HTMLSelectElement => {
      const wrapper = document.createElement('div');
      const caption = document.createElement('label');
      caption.htmlFor = id;
      caption.textContent = label;
      const select = document.createElement('select');
      select.id = id;
      for (const [optionValue, optionLabel] of options) {
        const option = document.createElement('option');
        option.value = optionValue;
        option.textContent = optionLabel;
        select.append(option);
      }
      const remembered = savedControl(mode, id, value);
      select.value = options.some(([candidate]) => candidate === remembered) ? remembered : value;
      wrapper.append(caption, select);
      optionFields.append(wrapper);
      return select;
    };
    if (mode.id.startsWith('date-')) {
      const [year = '2082', month = '4', day = '7'] = inputField.value.split('-');
      const values: HTMLInputElement[] = [];
      for (const [label, value, id] of [['Year', year, 'year'], ['Month', month, 'month'], ['Day', day, 'day']]) {
        const wrap = document.createElement('div'), caption = document.createElement('label'), field = document.createElement('input');
        field.id = `playground-${id}`;
        caption.htmlFor = field.id;
        caption.textContent = label;
        field.type = 'number';
        field.min = '1';
        field.max = id === 'month' ? '12' : id === 'day' ? '31' : '9999';
        field.value = value;
        field.inputMode = 'numeric';
        wrap.append(caption, field); optionFields.append(wrap); values.push(field);
      }
      const sync = () => {
        inputField.value = values.map((value) => value.value).join('-');
        void run();
      };
      values.forEach(v => v.addEventListener('input', sync));
      inputField.hidden = true;
      const dateOperations: Array<[string, string]> = mode.id === 'date-bs-to-ad'
        ? [['convert', 'Convert BS to AD'], ['parse-format', 'Parse / format BS'], ['add', 'Add days'], ['difference', 'Difference in days'], ['fiscal', 'Fiscal year']]
        : [['convert', 'Convert AD to BS'], ['parse-format', 'Parse / format AD'], ['add', 'Add days'], ['difference', 'Difference in days']];
      const task = addSelect('Date operation', 'playground-date-task', dateOperations, 'convert');

      const daysWrap = document.createElement('div');
      const daysLabel = document.createElement('label');
      const days = document.createElement('input');
      days.id = 'playground-date-days';
      daysLabel.htmlFor = days.id;
      daysLabel.textContent = 'Days to add';
      days.type = 'number';
      days.value = savedControl(mode, days.id, '1');
      daysWrap.append(daysLabel, days);
      optionFields.append(daysWrap);

      const secondary = document.createElement('fieldset');
      secondary.className = 'date-secondary';
      const legend = document.createElement('legend');
      legend.textContent = 'Compare with date';
      secondary.append(legend);
      for (const [label, id, value] of [['Year', 'year', year], ['Month', 'month', month], ['Day', 'day', day]]) {
        const wrap = document.createElement('label');
        wrap.textContent = label;
        const field = document.createElement('input');
        field.id = `playground-date-secondary-${id}`;
        field.type = 'number';
        field.value = savedControl(mode, field.id, value);
        field.min = '1';
        field.dataset.dateSecondary = id;
        wrap.append(field);
        secondary.append(wrap);
      }
      optionFields.append(secondary);

      const updateDateOptions = () => {
        daysWrap.hidden = task.value !== 'add';
        secondary.hidden = task.value !== 'difference';
      };
      task.addEventListener('change', () => {
        updateDateOptions();
        void run();
      });
      days.addEventListener('input', () => void run());
      secondary.querySelectorAll('input').forEach(field => field.addEventListener('input', () => void run()));
      updateDateOptions();
    } else if (mode.id === 'number') {
      inputField.hidden = false;
      const task = addSelect(
        'Number operation',
        'playground-number-operation',
        [['format', 'Format number'], ['parse', 'Parse number']],
        'format',
      );
      const grouping = addSelect(
        'Grouping',
        'playground-number-grouping',
        [['nepali', 'Nepali'], ['western', 'Western'], ['none', 'None']],
        'nepali',
      );
      const numerals = addSelect(
        'Digits',
        'playground-number-numerals',
        [['ascii', 'ASCII'], ['devanagari', 'Devanagari']],
        'ascii',
      );
      const updateNumberOptions = () => {
        grouping.disabled = numerals.disabled = task.value === 'parse';
      };
      task.addEventListener('change', () => {
        updateNumberOptions();
        void run();
      });
      [grouping, numerals].forEach((select) => select.addEventListener('change', () => void run()));
      updateNumberOptions();
    } else if (mode.id === 'words') {
      inputField.hidden = false;
      const task = addSelect(
        'Words operation',
        'playground-words-task',
        [['nepali', 'Number in Nepali'], ['english', 'Number in English'], ['npr', 'NPR amount in Nepali']],
        'nepali',
      );
      task.addEventListener('change', () => void run());
    } else if (mode.id === 'currency') {
      inputField.hidden = false;
      const placement = addSelect(
        'Symbol placement',
        'playground-currency-placement',
        [['before', 'Before amount'], ['after', 'After amount']],
        'before',
      );
      const numerals = addSelect(
        'Digits',
        'playground-currency-digits',
        [['devanagari', 'Devanagari'], ['ascii', 'ASCII']],
        'devanagari',
      );
      const symbol = addSelect(
        'Currency symbol',
        'playground-currency-symbol',
        [['रु', 'रु'], ['रू', 'रू'], ['नेरू', 'नेरू'], ['NPR', 'NPR']],
        'रु',
      );
      [placement, numerals, symbol].forEach((select) => select.addEventListener('change', () => void run()));
    } else if (mode.id === 'land') {
      inputField.hidden = true;
      const unit = addSelect(
        'Land system',
        'playground-land-system',
        [['hill', 'Hill (ropani/aana/paisa/daam)'], ['terai', 'Terai (bigha/kattha/dhur)']],
        'hill',
      );
      const fields = document.createElement('div');
      fields.className = 'land-fields';
      const unitDefinitions: Array<[string, string]> = [
        ['ropani', ''], ['aana', '15'], ['paisa', '3'], ['daam', '3'],
        ['bigha', ''], ['kattha', '19'], ['dhur', '19'],
      ];
      for (const [name, max] of unitDefinitions) {
        const wrap = document.createElement('label');
        wrap.textContent = name;
        const input = document.createElement('input');
        input.type = 'number';
        input.min = '0';
        if (max) input.max = max;
        input.step = '1';
        input.dataset.landUnit = name;
        input.value = savedControl(mode, `land:${name}`, name === 'ropani' ? inputField.value : '0');
        wrap.append(input);
        fields.append(wrap);
      }
      optionFields.append(fields);
      const refresh = () => {
        fields.querySelectorAll<HTMLInputElement>('[data-land-unit]').forEach((field) => {
          const hillUnit = ['ropani', 'aana', 'paisa', 'daam'].includes(field.dataset.landUnit!);
          field.parentElement!.hidden = unit.value === 'hill' ? !hillUnit : hillUnit;
        });
      };
      unit.addEventListener('change', () => {
        refresh();
        void run();
      });
      fields.querySelectorAll('input').forEach((field) => field.addEventListener('input', () => {
        inputField.value = field.value;
        void run();
      }));
      refresh();
    } else if (mode.id === 'admin') {
      inputField.hidden = false;
      const caption = document.createElement('p'); caption.textContent = 'Postal codes here follow the GPO-derived scheme (palika code; ward number appended), not legacy post-office codes.'; optionFields.append(caption);
    } else if (mode.id === 'collation') {
      inputField.hidden = true;
      const wrap = document.createElement('div');
      const label = document.createElement('label');
      const select = document.createElement('select');
      label.htmlFor = 'playground-collation-task';
      label.textContent = 'Text operation';
      select.id = 'playground-collation-task';
      for (const [value, title] of [['stats','Count text'],['sort','Sort lines'],['search','Search text']]) {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = title;
        select.append(option);
      }
      select.value = savedControl(mode, select.id, 'stats');
      wrap.append(label, select);

      const fieldLabel = document.createElement('label');
      const text = document.createElement('textarea');
      fieldLabel.htmlFor = 'playground-collation-text';
      fieldLabel.textContent = 'Text';
      text.id = 'playground-collation-text';
      text.value = modeStates.get(mode.id)?.input ?? inputField.value;
      text.rows = 4;
      optionFields.append(wrap,fieldLabel,text);
      const queryValue = savedControl(mode, 'playground-collation-query', 'नेपाल');
      inputField.dataset.searchQuery = queryValue;
      const ensureSearchField = () => {
        if (optionFields.querySelector<HTMLInputElement>('#playground-collation-query')) return;
        const queryLabel = document.createElement('label');
        const queryField = document.createElement('input');
        queryLabel.htmlFor = 'playground-collation-query';
        queryLabel.textContent = 'Search phrase';
        queryField.id = 'playground-collation-query';
        queryField.value = inputField.dataset.searchQuery ?? 'नेपाल';
        optionFields.append(queryLabel, queryField);
        queryField.addEventListener('input', () => {
          inputField.dataset.searchQuery = queryField.value;
          void run();
        });
      };
      if (select.value === 'search') ensureSearchField();
      text.addEventListener('input', () => void run());
      select.addEventListener('change', () => {
        if (select.value === 'search') ensureSearchField();
        void run();
      });
    }
    if (!mode.id.startsWith('date-') && mode.id !== 'land') inputField.hidden = false;
  }

  async function populateAdmin(
    restoredControls: Record<string, string> = {},
    isCurrent: () => boolean = () => true,
  ): Promise<void> {
    const mod = await load('nepali-toolkit/admin') as {
      getProvinces: () => readonly { code: string; nameEn: string; nameNe: string }[];
      getDistricts: (province?: string) => readonly { code: string; nameEn: string; nameNe: string }[];
      getPalikas: (district?: string) => readonly { code: string; nameEn: string; nameNe: string; wards: number }[];
    };
    if (!isCurrent()) return;

    const selected = (id: string) => (document.querySelector(`#${id}`) as HTMLSelectElement | null)?.value ?? '';
    const make = (
      id: string,
      label: string,
      rows: readonly { code: string; nameEn: string; nameNe: string }[],
      chosen: string,
      onChange: () => void,
    ): HTMLSelectElement => {
      let select = optionFields.querySelector<HTMLSelectElement>(`#${id}`);
      const isMounted = select !== null;
      if (!select) {
        const wrap = document.createElement('div');
        const caption = document.createElement('label');
        caption.htmlFor = id;
        caption.textContent = label;
        select = document.createElement('select');
        select.id = id;
        wrap.append(caption, select);
        optionFields.append(wrap);
      }

      const previous = isMounted ? chosen : (restoredControls[id] ?? chosen);
      select.replaceChildren();
      const empty = document.createElement('option');
      empty.value = '';
      empty.textContent = `Choose ${label.toLocaleLowerCase()}`;
      select.append(empty);
      for (const row of rows) {
        const option = document.createElement('option');
        option.value = row.code;
        option.textContent = `${row.nameEn} · ${row.nameNe}`;
        select.append(option);
      }
      select.value = previous;
      select.onchange = onChange;
      return select;
    };
    const fill = () => {
      const onChange = () => {
        fill();
        void run();
      };
      const province = make('playground-province', 'Province', mod.getProvinces(), selected('playground-province'), onChange);
      const districts = make(
        'playground-district',
        'District',
        mod.getDistricts(province.value || undefined),
        selected('playground-district'),
        onChange,
      );
      const palikas = make(
        'playground-palika',
        'Palika',
        mod.getPalikas(districts.value || undefined),
        selected('playground-palika'),
        onChange,
      );
      const palikaRow = mod.getPalikas(districts.value || undefined).find(row => row.code === palikas.value);
      const wards = palikaRow ? Array.from({ length: palikaRow.wards }, (_, index) => index + 1) : [];

      let ward = optionFields.querySelector<HTMLSelectElement>('#playground-ward');
      const wardIsMounted = ward !== null;
      if (!ward) {
        const wrap = document.createElement('div');
        const caption = document.createElement('label');
        caption.htmlFor = 'playground-ward';
        caption.textContent = 'Ward (optional)';
        ward = document.createElement('select');
        ward.id = 'playground-ward';
        wrap.append(caption, ward);
        optionFields.append(wrap);
      }
      const previousWard = wardIsMounted ? ward.value : (restoredControls['playground-ward'] ?? '');
      ward.replaceChildren();
      const palikaCodeOption = document.createElement('option');
      palikaCodeOption.value = '';
      palikaCodeOption.textContent = 'Palika postal code';
      ward.append(palikaCodeOption);
      for (const value of wards) {
        const option = document.createElement('option');
        option.value = String(value);
        option.textContent = `Ward ${value}`;
        ward.append(option);
      }
      ward.value = previousWard;
      ward.onchange = () => void run();
    };
    fill();
  }

  /** Stops a slow earlier run from overwriting a newer one. */
  let revision = 0;

  async function run(): Promise<void> {
    const current = ++revision;
    const mode = modeById(modeField.value);
    const isCurrent = () => current === revision && modeField.value === mode.id;
    const raw = activeInput(mode);
    rememberModeState(mode);
    const shortName = mode.entrypoint.split('/').pop() ?? mode.entrypoint;

    taskTitle.textContent = selectedTaskTitle(mode);
    taskDescription.textContent = mode.description;
    hint.textContent = mode.hint;
    inputField.placeholder = mode.placeholder;
    inputField.inputMode = mode.inputMode;
    entrypointLabel.textContent = mode.entrypoint;
    docsLink.href = `${siteBase}${mode.docs.slice(1)}`;
    docsLink.textContent = `Read the ${mode.reference} reference →`;
    note.hidden = true;
    if (mode.id === 'admin') {
      await populateAdmin(modeStates.get(mode.id)?.controls, isCurrent);
      if (!isCurrent()) return;
    }

    if (!isCurrent()) return;
    const url = new URL(window.location.href);
    url.searchParams.set('tool', mode.id);
    history.replaceState({ ...(history.state ?? {}), playgroundTool: mode.id }, '', url);

    // A cleared required field is a prompt, not a failure.
    if (raw.trim() === '' && !mode.optional) {
      paint({
        kind: 'empty',
        text: '—',
        guidance: `Enter a value to run the ${shortName} example.`,
      });
      return;
    }

    setState('loading', `Loading the ${shortName} module…`);
    copyResult.disabled = true;
    copySnippet.disabled = true;

    try {
      const outcome = await handlers[mode.id](mode, raw);
      if (!isCurrent()) return;

      if (mode.id === 'date-bs-to-ad' || mode.id === 'date-ad-to-bs') {
        // A range note is supplementary, so a failure here must not turn a
        // successful conversion into an error state.
        const resolved = await rangeNote(mode.id === 'date-bs-to-ad' ? 'bs' : 'ad').catch(
          () => undefined,
        );
        if (!isCurrent()) return;
        if (resolved !== undefined) {
          note.textContent = resolved;
          note.hidden = false;
        }
      }

      paint(outcome);
    } catch (error) {
      if (!isCurrent()) return;
      paint({ kind: 'error', message: describeError(error) });
    }
  }

  // --- Wiring -------------------------------------------------------------

  modeField.addEventListener('change', () => {
    rememberModeState(modeById(activeModeId));
    const next = modeById(modeField.value);
    markActiveNav(next.id);
    inputField.value = modeStates.get(next.id)?.input ?? next.sample;
    activeModeId = next.id;
    renderExamples(next);
    renderOptions(next);
    const nextUrl = new URL(window.location.href); nextUrl.searchParams.set('tool', next.id);
    history.pushState({ playgroundTool: next.id }, '', nextUrl);
    run();
  });
  inputField.addEventListener('input', run);
  searchField.addEventListener('input', () => {
    const query = searchField.value.trim().toLocaleLowerCase();
    for (const item of navItems) item.hidden = !item.textContent!.toLocaleLowerCase().includes(query);
    for (const group of document.querySelectorAll<HTMLElement>('.playground-nav-group')) group.hidden = !group.querySelector('.playground-nav-item:not([hidden])');
    for (const option of modeField.options) option.hidden = !option.textContent!.toLocaleLowerCase().includes(query);
  });
  function markActiveNav(id: string): void {
    navItems.forEach(item => { if (item.dataset.tool === id) item.setAttribute('aria-current','true'); else item.removeAttribute('aria-current'); });
  }
  navItems.forEach(item => item.addEventListener('click', () => {
    if (modeField.value === item.dataset.tool) return;
    modeField.value = item.dataset.tool!;
    modeField.dispatchEvent(new Event('change'));
  }));
  viewToggle.addEventListener('click', event => {
    const target = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-result-view]');
    if (!target || !painted.json) return;
    resultView = target.dataset.resultView as 'preview' | 'json';
    viewToggle.querySelectorAll('[data-result-view]').forEach(button => button.setAttribute('aria-pressed', String(button === target)));
    jsonSlot.hidden = resultView !== 'json'; valueSlot.hidden = resultView === 'json'; listSlot.hidden = resultView === 'json' || !currentIsList;
    showHairline(modeById(modeField.value));
  });
  function resetActiveMode(): void {
    const mode = modeById(modeField.value);
    modeStates.delete(mode.id);
    if (mode.id === 'collation') delete inputField.dataset.searchQuery;
    inputField.value = mode.sample;
    renderExamples(mode);
    renderOptions(mode);
    void run();
  }
  reset.addEventListener('click', resetActiveMode);
  const initialTool = new URL(window.location.href).searchParams.get('tool');
  if (initialTool && config.modes.some(mode => mode.id === initialTool)) {
    modeField.value = initialTool;
    inputField.value = modeById(initialTool).sample;
    activeModeId = initialTool as ModeId;
  }
  renderExamples(modeById(modeField.value));
  renderOptions(modeById(modeField.value));
  markActiveNav(modeField.value);
  void run();
  window.addEventListener('popstate', () => {
    rememberModeState(modeById(activeModeId));
    const tool = new URL(window.location.href).searchParams.get('tool');
    const restored = tool && config.modes.some(mode => mode.id === tool) ? tool : config.modes[0].id;
    modeField.value = restored;
    const mode = modeById(restored);
    activeModeId = mode.id;
    inputField.value = modeStates.get(mode.id)?.input ?? mode.sample;
    renderExamples(mode);
    renderOptions(mode);
    markActiveNav(restored);
    void run();
  });

  /**
   * Copies text and confirms in the button label and the live region, because
   * the async clipboard API is unavailable on insecure origins and blocked in
   * some browsers.
   */
  function wireCopy(button: HTMLButtonElement, read: () => string, label: string): void {
    const idle = button.textContent ?? '';
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      const text = read();
      if (text === '') return;
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
        status.textContent = `${label} copied to the clipboard.`;
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          button.textContent = idle;
        }, 2000);
      } catch {
        status.textContent = 'Copy is blocked in this browser. Select the text and copy it manually.';
      }
    });
  }

  wireCopy(copyResult, () => painted.result, 'Result');
  wireCopy(copySnippet, () => painted.snippet, 'Snippet');
  wireCopy(copyJson, () => painted.json, 'JSON');
</script>
