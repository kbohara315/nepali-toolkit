---
import { domains } from '../data/domains';
const base = import.meta.env.BASE_URL;
---
<section class="domain-index site-shell" aria-labelledby="domains-heading">
  <div class="section-heading"><p class="eyebrow">Focused entrypoints</p><h2 id="domains-heading">Eight domains, documented.</h2><p>One package. Import the conventions your application needs.</p></div>
  <div class="domain-index-grid">{domains.map((domain, index) => <article>
    <span class="eyebrow">{String(index + 1).padStart(2, '0')} / {domain.label}</span>
    <h3>{domain.heading}</h3><p>{domain.description}</p>
    <code class="domain-path">{domain.path}</code><pre><code>{domain.example}</code></pre>
    <a class="text-link" href={`${base}${domain.docs.slice(1)}`}>Read {domain.label.toLowerCase()} docs →</a>
  </article>)}</div>
</section>
