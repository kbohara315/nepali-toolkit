---
// Keep Starlight 0.42's native popover target and translated accessible name.
---
<button popovertarget="starlight__sidebar" class="sl-menu-button sl-flex md:sl-hidden print:hidden">
  <svg class="open-menu" aria-hidden="true" viewBox="0 0 24 24" fill="none">
    <path d="M4 6h16M4 12h16M4 18h16" />
  </svg>
  <svg class="close-menu" aria-hidden="true" viewBox="0 0 24 24" fill="none">
    <path d="m6 6 12 12M6 18 18 6" />
  </svg>
  <span class="sr-only">{Astro.locals.t('menuButton.accessibleLabel')}</span>
</button>

<style>
  button:has(~ :popover-open) .open-menu,
  button:not(:has(~ :popover-open)) .close-menu { display: none; }
</style>
