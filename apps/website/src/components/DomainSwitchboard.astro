---
import { domains } from '../data/domains';
import { demos, runDemo } from '../lib/demo-calls';
import { highlightCode } from '../lib/highlight-code';
import { getProvinces } from 'nepali-toolkit/admin/provinces';
import '../styles/switchboard.css';
const initial = await runDemo('number', demos.number.sample);
const base = import.meta.env.BASE_URL;
---
<section class="switchboard" aria-labelledby="board-heading" data-switchboard>
  <div class="board-bar"><h2 id="board-heading">Domain switchboard</h2><span aria-hidden="true">08 / 01 ACTIVE</span></div>
  <fieldset disabled class="domain-controls">
    <legend class="sr-only">Choose a toolkit domain</legend>
    {domains.map((domain, index) => <label class="domain-control">
      <input type="radio" name="toolkit-domain" value={domain.id} checked={domain.id === 'number'} />
      <span class="control-name"><small aria-hidden="true">{String(index + 1).padStart(2, '0')}</small>{domain.label}</span>
      <span class="toggle-track" aria-hidden="true"><span></span></span>
    </label>)}
  </fieldset>
  <div class="board-readout" data-state="success" aria-busy="false">
    <div class="readout-heading"><h3 id="board-title">{demos.number.title}</h3><span class="eyebrow" aria-hidden="true">LIVE API</span></div>
    <p id="board-purpose">{domains.find(domain => domain.id === 'number')!.description}</p>
    <label id="board-input-label" for="board-input">{demos.number.label}</label>
    <textarea id="board-input" rows="1" disabled spellcheck="false" autocomplete="off" aria-describedby="board-hint board-status" aria-invalid="false">{demos.number.sample}</textarea>
    <select id="board-province" hidden disabled aria-label="Province" aria-describedby="board-hint board-status">
      {getProvinces().map(province => <option value={province.code} selected={province.code === demos.admin.sample}>{province.nameEn}</option>)}
    </select>
    <p id="board-hint">{demos.number.hint}</p>
    <div class="result-label">RESULT <span id="board-unit"></span></div>
    <output id="board-output" for="board-input board-province">{initial.output}</output>
    <p id="board-status" role="status" aria-live="polite">Real output from the workspace package.</p>
    <pre class="board-code"><code id="board-snippet" set:html={highlightCode(initial.snippet)}></code></pre>
    <div class="readout-actions"><a id="board-docs" class="text-link" href={`${base}docs/reference/number/`}>Read number docs →</a><button id="board-copy" class="copy-button" type="button" disabled>Copy snippet</button></div>
    <p id="board-copy-status" role="status"></p>
  </div>
  <p class="board-nojs">Interactive examples require JavaScript. Explore all eight domains through the documentation links below.</p>
</section>
<script>
  import '../scripts/switchboard';
</script>
