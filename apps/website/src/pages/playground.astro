---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Playground from '../components/Playground.astro';
import '../styles/landing.css';
---

<MarketingLayout
  title="Playground | Nepali Toolkit"
  description="Try real nepali-toolkit calls in your browser — format Nepali numbers, convert BS/AD dates, validate phones and copy live working snippets."
>
  <SiteHeader />
  <main id="main">
    <h1 class="sr-only">Playground — try nepali-toolkit utilities live</h1>
    <Playground />
  </main>
  <SiteFooter />
</MarketingLayout>
