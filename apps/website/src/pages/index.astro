---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DomainConstellation from '../components/DomainConstellation.astro';
import Playground from '../components/Playground.astro';
import '../styles/landing.css';
const base = import.meta.env.BASE_URL;
---

<MarketingLayout
  title="Nepali Toolkit | Build for Nepal"
  description="Focused TypeScript utilities for Nepali dates, numbers, currency, land, words, phones, sorting, and administrative data."
>
  <SiteHeader />
  <main id="main">
    <section class="hero site-shell">
      <div class="hero-content">
        <p class="eyebrow">
          <span class="status-dot"></span> Local knowledge. Typed.
        </p>
        <h1>
          Build for Nepal.
          <br />
          <span>With less code.</span>
        </h1>
        <p class="hero-copy">
          From Bikram Sambat to lakh and crore. Eight focused TypeScript modules
          for the details that make software feel at home.
        </p>
        <div class="hero-actions">
          <a class="button primary" href={`${base}docs/getting-started/`}>
            Start building <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={`${base}playground/`}>
            Explore playground <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="install" data-install>
          <div class="install-tabs" role="group" aria-label="Package manager">
            {['pnpm', 'npm', 'yarn', 'bun'].map((manager) => (
              <button
                type="button"
                disabled
                data-manager={manager}
                aria-pressed={manager === 'pnpm'}
              >
                {manager}
              </button>
            ))}
            <span>INSTALL</span>
          </div>
          <div class="install-command">
            <code id="install-command">pnpm add nepali-toolkit</code>
            <button
              class="copy-button"
              id="copy-install"
              type="button"
              disabled
              aria-label="Copy install command"
            >
              Copy
            </button>
          </div>
          <span id="install-status" class="install-status" role="status"></span>
        </div>
        <p class="hero-note">
          Open source · MIT licensed · Zero runtime dependencies
        </p>
      </div>
      <DomainConstellation />
    </section>
    <section class="benefits site-shell" aria-label="Toolkit benefits">
      <div class="benefit">
        <span class="eyebrow">01 / Confidence</span>
        <h2>Types do the talking.</h2>
        <p>
          Discoverable, typed functions. Clear inputs and outputs, right in your
          editor.
        </p>
      </div>
      <div class="benefit">
        <span class="eyebrow">02 / Independence</span>
        <h2>Small by intention.</h2>
        <p>
          Zero runtime dependencies. Just the utilities you need, built on the
          platform.
        </p>
      </div>
      <div class="benefit">
        <span class="eyebrow">03 / Precision</span>
        <h2>Your domain. Your import.</h2>
        <p>
          Focused, tree-shakeable subpaths. ESM and CommonJS, ready for your
          stack.
        </p>
      </div>
    </section>
    <Playground />
    <section class="steps site-shell">
      <div class="section-heading">
        <p class="eyebrow">From install to implementation</p>
        <h2>
          Less plumbing.
          <br />
          More building.
        </h2>
        <p>
          Bring local conventions into your application with a focused import
          and a single function call.
        </p>
        <a class="text-link" href={`${base}docs/getting-started/`}>
          Your first integration <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="code-window">
        <div class="window-bar">
          <span>your-app.ts</span>
          <span>TypeScript</span>
        </div>
        <pre><code><span class="code-comment">// 01 — Pick your domain</span>
import &#123; formatNumber &#125; from 'nepali-toolkit/number';

<span class="code-comment">// 02 — Make it feel local</span>
const population = formatNumber('12345678');

<span class="code-comment">// 03 — Ship the details</span>
console.log(population); <span class="code-comment">// '1,23,45,678'</span></code></pre>
        <div class="code-caption">
          <span class="status-dot"></span> Familiar JavaScript. Nepali by
          default.
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</MarketingLayout>

<script>
  const command = document.querySelector('#install-command')!;
  const status = document.querySelector('#install-status')!;
  const managers =
    document.querySelectorAll<HTMLButtonElement>('[data-manager]');
  const copy = document.querySelector<HTMLButtonElement>('#copy-install')!;
  copy.disabled = false;
  managers.forEach((button) => {
    button.disabled = false;
    button.addEventListener('click', () => {
      const manager = button.dataset.manager;
      command.textContent = `${manager} ${manager === 'npm' ? 'install' : 'add'} nepali-toolkit`;
      copy.textContent = 'Copy';
      status.textContent = '';
      managers.forEach((item) =>
        item.setAttribute('aria-pressed', String(item === button)),
      );
    });
  });
  document
    .querySelector('#copy-install')
    ?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command.textContent ?? '');
        copy.textContent = 'Copied';
        status.textContent = 'Install command copied.';
      } catch {
        status.textContent =
          'Copy unavailable. Select the command to copy it manually.';
      }
    });
</script>
