---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DomainSwitchboard from '../components/DomainSwitchboard.astro';
import DomainIndex from '../components/DomainIndex.astro';
import '../styles/landing.css';
const base = import.meta.env.BASE_URL;
---

<MarketingLayout
  title="Nepali Toolkit | Local conventions. One toolkit."
  description="Focused TypeScript utilities for Nepali dates, numbers, currency, land, words, phones, sorting, and administrative data."
>
  <SiteHeader />
  <main id="main">
    <section class="hero site-shell">
      <div class="hero-content">
        <p class="eyebrow">
          Nepali Toolkit / TypeScript utilities
        </p>
        <h1>
          Nepali conventions.
          <span>Ready to import.</span>
        </h1>
        <p class="hero-copy">
          Dates, numbers, currency, land, words, sorting, phones, and administrative
          data. Focused TypeScript utilities for software built for Nepal.
        </p>
      </div>
      <DomainSwitchboard />
      <div class="hero-setup">
        <div class="hero-actions">
          <a class="button primary" href={`${base}docs/getting-started/`}>
            Get started <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href={`${base}playground/`}>
            Explore playground <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="install" data-install>
          <div class="install-tabs" role="group" aria-label="Package manager">
            {['pnpm', 'npm', 'yarn', 'bun'].map((manager) => (
              <button
                type="button"
                disabled
                data-manager={manager}
                aria-pressed={manager === 'pnpm'}
              >
                {manager}
              </button>
            ))}
            <span>INSTALL</span>
          </div>
          <div class="install-command">
            <code id="install-command"><span class="code-command" id="install-manager">pnpm</span> <span class="code-keyword" id="install-verb">add</span> <span class="code-package">nepali-toolkit</span></code>
            <button
              class="copy-button"
              id="copy-install"
              type="button"
              disabled
              aria-label="Copy install command"
            >
              Copy
            </button>
          </div>
          <span id="install-status" class="install-status" role="status"></span>
        </div>
        <p class="hero-note">
          Open source · MIT licensed · Zero runtime dependencies
        </p>
      </div>
    </section>
    <DomainIndex />
    <section class="precision site-shell" aria-labelledby="precision-heading">
    <div class="section-heading"><p class="eyebrow">Designed for the details</p><h2 id="precision-heading">Precision where it matters.</h2></div>
    <div class="benefits" aria-label="Toolkit precision">
      <div class="benefit">
        <span class="eyebrow">01 / Civil dates</span>
        <h3>A date is not a timestamp.</h3>
        <p>
          Work with explicit BS and AD civil dates. Conversion coverage and
          calendar-table boundaries are documented, rather than implied.
        </p>
      </div>
      <div class="benefit">
        <span class="eyebrow">02 / Decimal strings</span>
        <h3>Keep the digits you entered.</h3>
        <p>
          Supply numeric and currency values as strings where supported. Avoid
          rounding large values through a JavaScript number before formatting.
        </p>
      </div>
      <div class="benefit">
        <span class="eyebrow">03 / Data revisions</span>
        <h3>Know what your data represents.</h3>
        <p>
          Administrative datasets have source and revision notes. Read their
          coverage before relying on a lookup in your application.
        </p>
      </div>
    </div>
    <a class="text-link precision-link" href={`${base}docs/project/data-sources/`}>Read data sources and coverage →</a>
    </section>
    <section class="steps site-shell">
      <div class="section-heading">
        <p class="eyebrow">From install to implementation</p>
        <h2>
          Less plumbing.
          <br />
          More building.
        </h2>
        <p>
          Bring local conventions into your application with a focused import
          and a single function call.
        </p>
        <a class="text-link" href={`${base}docs/getting-started/`}>
          Your first integration <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="code-window">
        <pre><code><span class="code-comment">// 01 — Pick your domain</span>
<span class="code-keyword">import</span> &#123; <span class="code-function">formatNumber</span> &#125; <span class="code-keyword">from</span> <span class="code-string">'nepali-toolkit/number'</span>;

<span class="code-comment">// 02 — Make it feel local</span>
<span class="code-keyword">const</span> population = <span class="code-function">formatNumber</span>(<span class="code-string">'12345678'</span>);

<span class="code-comment">// 03 — Ship the details</span>
<span class="code-function">console.log</span>(population); <span class="code-comment">// '1,23,45,678'</span></code></pre>
        <div class="code-caption">
          <span class="status-dot"></span> Familiar JavaScript. Nepali by
          default.
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</MarketingLayout>

<script>
  const command = document.querySelector('#install-command')!;
  const managerOutput = document.querySelector('#install-manager')!;
  const verbOutput = document.querySelector('#install-verb')!;
  const status = document.querySelector('#install-status')!;
  const managers =
    document.querySelectorAll<HTMLButtonElement>('[data-manager]');
  const copy = document.querySelector<HTMLButtonElement>('#copy-install')!;
  copy.disabled = false;
  managers.forEach((button) => {
    button.disabled = false;
    button.addEventListener('click', () => {
      const manager = button.dataset.manager;
      managerOutput.textContent = manager ?? '';
      verbOutput.textContent = manager === 'npm' ? 'install' : 'add';
      copy.textContent = 'Copy';
      status.textContent = '';
      managers.forEach((item) =>
        item.setAttribute('aria-pressed', String(item === button)),
      );
    });
  });
  document
    .querySelector('#copy-install')
    ?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command.textContent ?? '');
        copy.textContent = 'Copied';
        status.textContent = 'Install command copied.';
      } catch {
        status.textContent =
          'Copy unavailable. Select the command to copy it manually.';
      }
    });
</script>
