{
  "name": "nepali-toolkit",
  "version": "0.1.0",
  "description": "JavaScript and TypeScript utilities for Nepal: bidirectional Bikram Sambat (BS)/Gregorian (AD) date conversion, Nepali numbers, NPR currency, land units, words, phone validation, collation, and administrative data.",
  "author": "Kshitij Bohara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbohara315/nepali-toolkit.git",
    "directory": "packages/nepali-toolkit"
  },
  "homepage": "https://kbohara315.github.io/nepali-toolkit/",
  "bugs": {
    "url": "https://github.com/kbohara315/nepali-toolkit/issues"
  },
  "keywords": [
    "nepali",
    "nepal",
    "bikram-sambat",
    "bikram-sambat-converter",
    "nepali-date",
    "nepali-date-converter",
    "javascript",
    "js",
    "bs-ad-converter",
    "ad-to-bs",
    "bs-to-ad",
    "nepali-calendar",
    "patro",
    "nepali-number",
    "devanagari",
    "npr",
    "nepali-currency",
    "nepali-rupees",
    "nepali-localization",
    "amount-in-words",
    "ropani",
    "land-measurement",
    "nepali-phone",
    "phone-validation",
    "provinces",
    "districts",
    "palikas",
    "typescript",
    "tree-shaking"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./date": {
      "types": "./dist/date/index.d.ts",
      "import": "./dist/date/index.js",
      "require": "./dist/date/index.cjs"
    },
    "./date/convert": {
      "types": "./dist/date/convert.d.ts",
      "import": "./dist/date/convert.js",
      "require": "./dist/date/convert.cjs"
    },
    "./date/value": {
      "types": "./dist/date/value.d.ts",
      "import": "./dist/date/value.js",
      "require": "./dist/date/value.cjs"
    },
    "./date/arithmetic": {
      "types": "./dist/date/arithmetic.d.ts",
      "import": "./dist/date/arithmetic.js",
      "require": "./dist/date/arithmetic.cjs"
    },
    "./date/format": {
      "types": "./dist/date/format.d.ts",
      "import": "./dist/date/format.js",
      "require": "./dist/date/format.cjs"
    },
    "./date/format-display": {
      "types": "./dist/date/format-display.d.ts",
      "import": "./dist/date/format-display.js",
      "require": "./dist/date/format-display.cjs"
    },
    "./date/parse": {
      "types": "./dist/date/parse.d.ts",
      "import": "./dist/date/parse.js",
      "require": "./dist/date/parse.cjs"
    },
    "./date/fiscal": {
      "types": "./dist/date/fiscal.d.ts",
      "import": "./dist/date/fiscal.js",
      "require": "./dist/date/fiscal.cjs"
    },
    "./date/relative": {
      "types": "./dist/date/relative.d.ts",
      "import": "./dist/date/relative.js",
      "require": "./dist/date/relative.cjs"
    },
    "./date/range": {
      "types": "./dist/date/range.d.ts",
      "import": "./dist/date/range.js",
      "require": "./dist/date/range.cjs"
    },
    "./date/locale/en": {
      "types": "./dist/date/locale/en.d.ts",
      "import": "./dist/date/locale/en.js",
      "require": "./dist/date/locale/en.cjs"
    },
    "./date/locale/ne": {
      "types": "./dist/date/locale/ne.d.ts",
      "import": "./dist/date/locale/ne.js",
      "require": "./dist/date/locale/ne.cjs"
    },
    "./date/adapters/date": {
      "types": "./dist/date/adapters/date.d.ts",
      "import": "./dist/date/adapters/date.js",
      "require": "./dist/date/adapters/date.cjs"
    },
    "./date/adapters/temporal": {
      "types": "./dist/date/adapters/temporal.d.ts",
      "import": "./dist/date/adapters/temporal.js",
      "require": "./dist/date/adapters/temporal.cjs"
    },
    "./date/adapters/timezone": {
      "types": "./dist/date/adapters/timezone.d.ts",
      "import": "./dist/date/adapters/timezone.js",
      "require": "./dist/date/adapters/timezone.cjs"
    },
    "./number": {
      "types": "./dist/number/index.d.ts",
      "import": "./dist/number/index.js",
      "require": "./dist/number/index.cjs"
    },
    "./number/digits": {
      "types": "./dist/number/digits.d.ts",
      "import": "./dist/number/digits.js",
      "require": "./dist/number/digits.cjs"
    },
    "./currency": {
      "types": "./dist/currency/index.d.ts",
      "import": "./dist/currency/index.js",
      "require": "./dist/currency/index.cjs"
    },
    "./land": {
      "types": "./dist/land/index.d.ts",
      "import": "./dist/land/index.js",
      "require": "./dist/land/index.cjs"
    },
    "./words": {
      "types": "./dist/words/index.d.ts",
      "import": "./dist/words/index.js",
      "require": "./dist/words/index.cjs"
    },
    "./collation": {
      "types": "./dist/collation/index.d.ts",
      "import": "./dist/collation/index.js",
      "require": "./dist/collation/index.cjs"
    },
    "./phone": {
      "types": "./dist/phone/index.d.ts",
      "import": "./dist/phone/index.js",
      "require": "./dist/phone/index.cjs"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js",
      "require": "./dist/admin/index.cjs"
    },
    "./admin/provinces": {
      "types": "./dist/admin/provinces.d.ts",
      "import": "./dist/admin/provinces.js",
      "require": "./dist/admin/provinces.cjs"
    },
    "./admin/districts": {
      "types": "./dist/admin/districts.d.ts",
      "import": "./dist/admin/districts.js",
      "require": "./dist/admin/districts.cjs"
    },
    "./admin/palikas": {
      "types": "./dist/admin/palikas.d.ts",
      "import": "./dist/admin/palikas.js",
      "require": "./dist/admin/palikas.cjs"
    },
    "./admin/hierarchy": {
      "types": "./dist/admin/hierarchy.d.ts",
      "import": "./dist/admin/hierarchy.js",
      "require": "./dist/admin/hierarchy.cjs"
    },
    "./admin/postal": {
      "types": "./dist/admin/postal.d.ts",
      "import": "./dist/admin/postal.js",
      "require": "./dist/admin/postal.cjs"
    },
    "./admin/validate": {
      "types": "./dist/admin/validate.d.ts",
      "import": "./dist/admin/validate.js",
      "require": "./dist/admin/validate.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:date": "node src/date/scripts/generate-data.mjs",
    "generate:admin": "node scripts/generate-admin.mjs",
    "verify:admin": "node scripts/verify-admin-sources.mjs",
    "verify:date": "node src/date/scripts/verify-data.mjs",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "benchmark:runtime": "npm run build && node scripts/benchmark-runtime.mjs",
    "benchmark:runtime:json": "node scripts/benchmark-runtime.mjs --json",
    "benchmark:runtime:compare": "node scripts/compare-runtime.mjs",
    "verify:package": "npm run build && node scripts/verify-package.mjs && node scripts/verify-tree-shaking.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.5",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
